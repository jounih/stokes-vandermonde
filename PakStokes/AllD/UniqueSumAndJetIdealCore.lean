/-! ### 1. Compactness & Codex's Section 8 Unique-Sum Isolation Tree Theorem -/

section UniqueSumTree

/-- `HasUniqueRep lam k t s` means `s : Multiset ℕ` is the unique multiset of cardinality at most
`k` whose `lam`-sum equals `t`. -/
def HasUniqueRep (lam : ℕ → ℝ) (k : ℕ) (t : ℝ) (s : Multiset ℕ) : Prop :=
  s.card ≤ k ∧ (s.map lam).sum = t ∧
    ∀ s' : Multiset ℕ, s'.card ≤ k → (s'.map lam).sum = t → s' = s

/-- Elementary subsequence dichotomy in `ℕ`: every sequence `u : ℕ → ℕ` admits a strictly
increasing subsequence along which it is either constant or diverges to `+∞`. -/
theorem nat_seq_subseq_dichotomy (u : ℕ → ℕ) :
    (∃ c : ℕ, ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∀ m, u (ψ m) = c) ∨
      (∃ ψ : ℕ → ℕ, StrictMono ψ ∧ Tendsto (u ∘ ψ) atTop atTop) := by
  by_cases hbdd : ∃ M : ℕ, ∀ m, u m ≤ M
  · left
    obtain ⟨M, hM⟩ := hbdd
    let f : ℕ → Fin (M + 1) := fun m => ⟨u m, Nat.lt_succ_of_le (hM m)⟩
    obtain ⟨c, hc⟩ := Finite.exists_infinite_fiber f
    have hfreq : ∃ᶠ m in atTop, u m = c.val := by
      rw [Filter.frequently_atTop]
      intro K
      by_contra hall
      push Not at hall
      have hsub : f ⁻¹' {c} ⊆ (Finset.range K : Set ℕ) := by
        intro m hm
        have hEq : u m = c.val := congrArg Fin.val (Set.mem_singleton_iff.mp hm)
        by_contra hlt
        simp only [Finset.coe_range, Set.mem_Iio, not_lt] at hlt
        exact hall m hlt hEq
      exact (Set.infinite_coe_iff.mp hc) ((Finset.range K).finite_toSet.subset hsub)
    obtain ⟨ψ, hψ_mono, hψ_eq⟩ := extraction_of_frequently_atTop hfreq
    exact ⟨c.val, ψ, hψ_mono, hψ_eq⟩
  · right
    push Not at hbdd
    have hstep : ∀ (a : ℕ) (M : ℕ), ∃ b > a, M < u b := by
      intro a M
      let B := (Finset.Iic a).sup u
      obtain ⟨b, hb⟩ := hbdd (max B M)
      refine ⟨b, ?_, lt_of_le_of_lt (le_max_right B M) hb⟩
      by_contra hle
      have hmem_a : b ∈ Finset.Iic a := Finset.mem_Iic.mpr (not_lt.mp hle)
      have hub : u b ≤ B := Finset.le_sup (f := u) hmem_a
      exact not_lt_of_ge (le_trans hub (le_max_left B M)) hb
    let ψ : ℕ → ℕ := Nat.rec 0 fun n prev => Classical.choose (hstep prev n)
    have hψ_step : ∀ n, ψ n < ψ (n + 1) ∧ n < u (ψ (n + 1)) := fun n =>
      Classical.choose_spec (hstep (ψ n) n)
    have hψ_mono : StrictMono ψ := strictMono_nat_of_lt_succ fun n => (hψ_step n).1
    have huψ_top : Tendsto (u ∘ ψ) atTop atTop := by
      rw [Filter.tendsto_atTop_atTop]
      intro b
      refine ⟨b + 1, fun n hn => ?_⟩
      obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : n ≠ 0)
      have hk : k < u (ψ (k + 1)) := (hψ_step k).2
      change b ≤ u (ψ (k + 1))
      omega
    exact ⟨ψ, hψ_mono, huψ_top⟩

/-- Compactness of `S ∪ {0}` for any real sequence `lam n → 0`. -/
theorem isCompact_range_union_zero {lam : ℕ → ℝ} (hlim : Tendsto lam atTop (nhds 0)) :
    IsCompact (Set.range lam ∪ ({0} : Set ℝ)) := by
  rw [isCompact_iff_isSeqCompact]
  intro u hu
  by_cases hzero : ∃ᶠ n in atTop, u n = 0
  · obtain ⟨φ, hφ_mono, hφ_eq⟩ := extraction_of_frequently_atTop hzero
    refine ⟨0, Or.inr rfl, φ, hφ_mono, ?_⟩
    simp [Function.comp_def, hφ_eq]
  · rw [Filter.not_frequently] at hzero
    obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp hzero
    have hmem : ∀ n ≥ N, ∃ m : ℕ, lam m = u n := fun n hn => by
      rcases hu n with ⟨m, hm⟩ | h0
      · exact ⟨m, hm⟩
      · exact absurd h0 (hN n hn)
    choose idx hidx using hmem
    let g : ℕ → ℕ := fun n => idx (n + N) (Nat.le_add_left N n)
    have hg_eq : ∀ n, lam (g n) = u (n + N) := fun n => hidx (n + N) (Nat.le_add_left N n)
    rcases nat_seq_subseq_dichotomy g with ⟨c, ψ, hψ_mono, hψ_eq⟩ | ⟨ψ, hψ_mono, hgψ_top⟩
    · refine ⟨lam c, Or.inl ⟨c, rfl⟩, fun k => ψ k + N,
        fun a b hab => Nat.add_lt_add_right (hψ_mono hab) N, ?_⟩
      have hconst : u ∘ (fun k => ψ k + N) = fun _ => lam c := by
        funext k; simp only [Function.comp_apply, ← hg_eq, hψ_eq]
      rw [hconst]
      exact tendsto_const_nhds
    · refine ⟨0, Or.inr rfl, fun k => ψ k + N,
        fun a b hab => Nat.add_lt_add_right (hψ_mono hab) N, ?_⟩
      have hcomp : u ∘ (fun k => ψ k + N) = lam ∘ (g ∘ ψ) := by
        funext k; simp [Function.comp_def, hg_eq]
      rw [hcomp]
      exact hlim.comp hgψ_top

/-- Coordinatewise subsequence extraction for sequences of `r`-tuples in `ℕ`: every sequence
`a : ℕ → Fin r → ℕ` admits a strictly increasing subsequence `ψ`, a subset `I : Finset (Fin r)`
of stabilized coordinates, and limit values `c : Fin r → ℕ` such that coordinates in `I` are
constant along `ψ` while coordinates outside `I` tend to `+∞`. -/
theorem nat_tuple_subseq_dichotomy :
    ∀ (r : ℕ) (a : ℕ → Fin r → ℕ),
      ∃ (ψ : ℕ → ℕ) (I : Finset (Fin r)) (c : Fin r → ℕ),
        StrictMono ψ ∧
          (∀ i ∈ I, ∀ m, a (ψ m) i = c i) ∧
          (∀ i ∉ I, Tendsto (fun m => a (ψ m) i) atTop atTop)
  | 0, _ =>
    ⟨id, ∅, Fin.elim0, strictMono_id, fun i => Fin.elim0 i, fun i => Fin.elim0 i⟩
  | r + 1, a => by
    let aInit : ℕ → Fin r → ℕ := fun m i => a m i.castSucc
    obtain ⟨ψ₁, I₁, c₁, hψ₁_mono, hψ₁_const, hψ₁_top⟩ :=
      nat_tuple_subseq_dichotomy r aInit
    rcases nat_seq_subseq_dichotomy (fun m => a (ψ₁ m) (Fin.last r)) with
      ⟨cLast, ψ₂, hψ₂_mono, hψ₂_const⟩ | ⟨ψ₂, hψ₂_mono, hψ₂_top⟩
    · let ψ := ψ₁ ∘ ψ₂
      let I : Finset (Fin (r + 1)) := insert (Fin.last r) (I₁.map Fin.castSuccEmb)
      let c : Fin (r + 1) → ℕ := Fin.snoc c₁ cLast
      refine ⟨ψ, I, c, hψ₁_mono.comp hψ₂_mono, ?_, ?_⟩
      · intro i
        refine Fin.lastCases ?_ ?_ i
        · intro _ m
          simp only [c, Fin.snoc_last, ψ, Function.comp_apply]
          exact hψ₂_const m
        · intro j hjI m
          have hj : j ∈ I₁ := by
            rcases Finset.mem_insert.mp hjI with hEq | hMap
            · exact absurd hEq (Fin.castSucc_ne_last j)
            · rcases Finset.mem_map.mp hMap with ⟨j', hj', hEq⟩
              exact (Fin.castSucc_injective r hEq) ▸ hj'
          simp only [c, Fin.snoc_castSucc, ψ, Function.comp_apply]
          exact hψ₁_const j hj (ψ₂ m)
      · intro i
        refine Fin.lastCases ?_ ?_ i
        · intro hnot
          exact absurd (Finset.mem_insert_self _ _) hnot
        · intro j hnot
          have hj : j ∉ I₁ := fun hj =>
            hnot (Finset.mem_insert_of_mem (Finset.mem_map.mpr ⟨j, hj, rfl⟩))
          exact (hψ₁_top j hj).comp hψ₂_mono.tendsto_atTop
    · let ψ := ψ₁ ∘ ψ₂
      let I : Finset (Fin (r + 1)) := I₁.map Fin.castSuccEmb
      let c : Fin (r + 1) → ℕ := Fin.snoc c₁ 0
      refine ⟨ψ, I, c, hψ₁_mono.comp hψ₂_mono, ?_, ?_⟩
      · intro i hi m
        rcases Finset.mem_map.mp hi with ⟨j, hj, rfl⟩
        change a (ψ₁ (ψ₂ m)) j.castSucc = Fin.snoc (α := fun _ => ℕ) c₁ 0 j.castSucc
        rw [Fin.snoc_castSucc]
        exact hψ₁_const j hj (ψ₂ m)
      · intro i
        refine Fin.lastCases ?_ ?_ i
        · intro _
          exact hψ₂_top
        · intro j hnot
          have hj : j ∉ I₁ := fun hj => hnot (Finset.mem_map.mpr ⟨j, hj, rfl⟩)
          exact (hψ₁_top j hj).comp hψ₂_mono.tendsto_atTop

/-- Every multiset `s : Multiset α` of cardinality `r` can be written as `Finset.univ.val.map f`
for some `f : Fin r → α`. -/
lemma multiset_eq_map_univ {α : Type*} {r : ℕ} (s : Multiset α) (hs : s.card = r) :
    ∃ f : Fin r → α, Finset.univ.val.map f = s := by
  let L := s.toList
  have hlen : L.length = r := by rw [Multiset.length_toList, hs]
  let f : Fin r → α := fun i => L.get (i.cast hlen.symm)
  refine ⟨f, ?_⟩
  have hofFn : (List.ofFn f) = L := by
    apply List.ext_getElem
    · simp [hlen]
    · intro n hn1 hn2
      simp [f]
  have hfinRange : ((List.finRange r).map f) = List.ofFn f := by
    apply List.ext_getElem
    · simp
    · intro n hn1 hn2
      simp
  have huniv_val : (Finset.univ : Finset (Fin r)).val = (List.finRange r : Multiset (Fin r)) := rfl
  rw [huniv_val, Multiset.map_coe, hfinRange, hofFn]
  exact Multiset.coe_toList s

/-- Helper expressing the sum of `g` over `Finset.univ.val.map f` as a `Finset` sum. -/
lemma multiset_map_univ_sum {α β : Type*} [AddCommMonoid β] {r : ℕ}
    (f : Fin r → α) (g : α → β) :
    ((Finset.univ.val.map f).map g).sum = ∑ i : Fin r, g (f i) := by
  rw [Multiset.map_map]
  rfl

/-- **Unique-Sum Inductive Extension Lemma (Codex Theorem 8.1 isolation step):**
If `lam : ℕ → ℝ` is injective, nowhere zero, and tends to `0`, and `t : ℝ` has a unique
`≤ k`-representation `s` with `s.card = k`, then for all sufficiently large `n`,
`t + lam n` has a unique `≤ (k + 1)`-representation, namely `n ::ₘ s` (of cardinality `k + 1`). -/
theorem uniqueSum_extension_cofinite {lam : ℕ → ℝ}
    (h_inj : Function.Injective lam) (h_ne : ∀ n, lam n ≠ 0)
    (h_lim : Tendsto lam atTop (nhds 0))
    {k : ℕ} {t : ℝ} {s : Multiset ℕ}
    (h_rep : HasUniqueRep lam k t s) (h_card : s.card = k) :
    ∀ᶠ n in atTop, HasUniqueRep lam (k + 1) (t + lam n) (n ::ₘ s) ∧ (n ::ₘ s).card = k + 1 := by
  by_contra hnot
  have hnot' : ¬ ∀ᶠ n in atTop, HasUniqueRep lam (k + 1) (t + lam n) (n ::ₘ s) := fun hev =>
    hnot (hev.mono fun n hn => ⟨hn, by simp [h_card]⟩)
  have hfreq : ∃ᶠ n in atTop, ¬ HasUniqueRep lam (k + 1) (t + lam n) (n ::ₘ s) :=
    Filter.not_eventually.mp hnot'
  obtain ⟨φ, hφ_mono, hφ_bad⟩ := extraction_of_frequently_atTop hfreq
  -- For each m, extract a competing multiset s'_m ≠ φ m ::ₘ s of card ≤ k + 1 with same sum
  have hcomp : ∀ m, ∃ s' : Multiset ℕ,
      s'.card ≤ k + 1 ∧ (s'.map lam).sum = t + lam (φ m) ∧ s' ≠ φ m ::ₘ s := by
    intro m
    have hcard_ns : (φ m ::ₘ s).card ≤ k + 1 := by simp [h_card]
    have hsum_ns : ((φ m ::ₘ s).map lam).sum = t + lam (φ m) := by
      rw [Multiset.map_cons, Multiset.sum_cons, h_rep.2.1, add_comm]
    have hbad := hφ_bad m
    unfold HasUniqueRep at hbad
    push Not at hbad
    exact hbad hcard_ns hsum_ns
  choose s' hs'_card hs'_sum hs'_ne using hcomp
  -- Pass to a subsequence with constant cardinality r ≤ k + 1
  let cardFn : ℕ → Fin (k + 2) := fun m => ⟨(s' m).card, Nat.lt_succ_of_le (hs'_card m)⟩
  obtain ⟨rFin, hrInf⟩ := Finite.exists_infinite_fiber cardFn
  have hfreq_r : ∃ᶠ m in atTop, (s' m).card = rFin.val := by
    rw [Filter.frequently_atTop]
    intro K
    by_contra hall
    push Not at hall
    have hsub : cardFn ⁻¹' {rFin} ⊆ (Finset.range K : Set ℕ) := by
      intro m hm
      have hEq : (s' m).card = rFin.val := congrArg Fin.val (Set.mem_singleton_iff.mp hm)
      by_contra hlt
      simp only [Finset.coe_range, Set.mem_Iio, not_lt] at hlt
      exact hall m hlt hEq
    exact (Set.infinite_coe_iff.mp hrInf) ((Finset.range K).finite_toSet.subset hsub)
  obtain ⟨τ, hτ_mono, hτ_card⟩ := extraction_of_frequently_atTop hfreq_r
  let r : ℕ := rFin.val
  have hr_le : r ≤ k + 1 := Nat.le_of_lt_succ rFin.isLt
  -- Represent each s' (τ m) as Finset.univ.val.map (a m)
  have htuple : ∀ m, ∃ f : Fin r → ℕ, Finset.univ.val.map f = s' (τ m) :=
    fun m => multiset_eq_map_univ (s' (τ m)) (hτ_card m)
  choose a ha using htuple
  -- Apply coordinatewise subsequence dichotomy to a : ℕ → Fin r → ℕ
  obtain ⟨ψ, I, c, hψ_mono, hψ_const, hψ_top⟩ := nat_tuple_subseq_dichotomy r a
  have hsum_eq : ∀ m, ∑ i : Fin r, lam (a (ψ m) i) = t + lam (φ (τ (ψ m))) := fun m => by
    rw [← multiset_map_univ_sum (a (ψ m)) lam, ha (ψ m), hs'_sum (τ (ψ m))]
  -- Step A: Take limit as m → ∞ to get ∑ i ∈ I, lam (c i) = t
  have hlim_lhs : Tendsto (fun m => ∑ i : Fin r, lam (a (ψ m) i)) atTop
      (nhds (∑ i ∈ I, lam (c i))) := by
    have hrew : (fun m => ∑ i : Fin r, lam (a (ψ m) i)) =
        fun m => (∑ i ∈ I, lam (c i)) + ∑ i ∈ Finset.univ \ I, lam (a (ψ m) i) := by
      funext m
      rw [← Finset.sum_sdiff (Finset.subset_univ I), add_comm]
      congr 1
      exact Finset.sum_congr rfl fun i hi => by rw [hψ_const i hi m]
    rw [hrew]
    have htail : Tendsto (fun m => ∑ i ∈ Finset.univ \ I, lam (a (ψ m) i)) atTop (nhds 0) := by
      have hsum_zero : ∀ (S : Finset (Fin r)), (∀ i ∈ S, i ∉ I) →
          Tendsto (fun m => ∑ i ∈ S, lam (a (ψ m) i)) atTop (nhds 0) := by
        intro S
        induction S using Finset.induction_on with
        | empty =>
          intro _
          simp
        | @insert i₀ S hi₀ ih =>
          intro hS
          have h1 : Tendsto (fun m => lam (a (ψ m) i₀)) atTop (nhds 0) :=
            h_lim.comp (hψ_top i₀ (hS i₀ (Finset.mem_insert_self i₀ S)))
          have h2 : Tendsto (fun m => ∑ i ∈ S, lam (a (ψ m) i)) atTop (nhds 0) :=
            ih fun i hi => hS i (Finset.mem_insert_of_mem hi)
          have hrew' : (fun m => ∑ i ∈ insert i₀ S, lam (a (ψ m) i)) =
              fun m => lam (a (ψ m) i₀) + ∑ i ∈ S, lam (a (ψ m) i) := by
            funext m; exact Finset.sum_insert hi₀
          rw [hrew']
          simpa using h1.add h2
      exact hsum_zero (Finset.univ \ I) fun i hi => (Finset.mem_sdiff.mp hi).2
    simpa using tendsto_const_nhds.add htail
  have hlim_rhs : Tendsto (fun m => t + lam (φ (τ (ψ m)))) atTop (nhds t) := by
    have hcomp_top : Tendsto (fun m => φ (τ (ψ m))) atTop atTop :=
      (hφ_mono.comp (hτ_mono.comp hψ_mono)).tendsto_atTop
    simpa using tendsto_const_nhds.add (h_lim.comp hcomp_top)
  have hsum_I : ∑ i ∈ I, lam (c i) = t := by
    have hlim_lhs' : Tendsto (fun m => t + lam (φ (τ (ψ m)))) atTop (nhds (∑ i ∈ I, lam (c i))) := by
      simpa only [hsum_eq] using hlim_lhs
    exact tendsto_nhds_unique hlim_lhs' hlim_rhs
  -- Step B: I cannot be all of Finset.univ (else lam (φ (τ (ψ 0))) = 0)
  have hI_ne_univ : I ≠ Finset.univ := by
    intro hIuniv
    have h0 := hsum_eq 0
    have hlhs0 : ∑ i : Fin r, lam (a (ψ 0) i) = t := by
      rw [← hIuniv]
      calc ∑ i ∈ I, lam (a (ψ 0) i) = ∑ i ∈ I, lam (c i) :=
            Finset.sum_congr rfl fun i hi => by rw [hψ_const i hi 0]
        _ = t := hsum_I
    rw [hlhs0] at h0
    have hlam0 : lam (φ (τ (ψ 0))) = 0 := by linarith
    exact h_ne _ hlam0
  have hI_lt_r : I.card < r := by
    have hlt := Finset.card_lt_card (Finset.ssubset_univ_iff.mpr hI_ne_univ)
    simpa using hlt
  have hI_le_k : I.card ≤ k := by omega
  -- Step C: I.val.map c represents t with card ≤ k, so I.val.map c = s and I.card = k
  let s₀ : Multiset ℕ := I.val.map c
  have hs₀_card : s₀.card ≤ k := by simp [s₀, hI_le_k]
  have hs₀_sum : (s₀.map lam).sum = t := by
    change ((I.val.map c).map lam).sum = t
    rw [Multiset.map_map]
    exact hsum_I
  have hs₀_eq_s : s₀ = s := h_rep.2.2 s₀ hs₀_card hs₀_sum
  have hI_card_eq_k : I.card = k := by
    have : s₀.card = s.card := congrArg Multiset.card hs₀_eq_s
    simpa [s₀, h_card] using this
  -- Step D: Hence r = k + 1 and Finset.univ \ I is a singleton {i₀}
  have hr_eq : r = k + 1 := by omega
  have hsdiff_card : (Finset.univ \ I).card = 1 := by
    rw [Finset.card_sdiff, Finset.inter_univ, Finset.card_univ, Fintype.card_fin]
    omega
  obtain ⟨i₀, hi₀_eq⟩ := Finset.card_eq_one.mp hsdiff_card
  have hi₀_not_mem : i₀ ∉ I := by
    have : i₀ ∈ Finset.univ \ I := hi₀_eq.symm ▸ Finset.mem_singleton_self i₀
    exact (Finset.mem_sdiff.mp this).2
  have huniv_eq : (Finset.univ : Finset (Fin r)) = insert i₀ I := by
    ext j
    simp only [Finset.mem_univ, Finset.mem_insert, true_iff]
    by_cases hj : j ∈ I
    · exact Or.inr hj
    · left
      have : j ∈ Finset.univ \ I := Finset.mem_sdiff.mpr ⟨Finset.mem_univ j, hj⟩
      rw [hi₀_eq, Finset.mem_singleton] at this
      exact this
  -- Step E: Evaluate sum at m = 0 to identify a (ψ 0) i₀ = φ (τ (ψ 0))
  have hsum0 := hsum_eq 0
  rw [huniv_eq, Finset.sum_insert hi₀_not_mem] at hsum0
  have hrest0 : ∑ i ∈ I, lam (a (ψ 0) i) = t := by
    calc ∑ i ∈ I, lam (a (ψ 0) i) = ∑ i ∈ I, lam (c i) :=
          Finset.sum_congr rfl fun i hi => by rw [hψ_const i hi 0]
      _ = t := hsum_I
  rw [hrest0] at hsum0
  have hlam_eq : lam (a (ψ 0) i₀) = lam (φ (τ (ψ 0))) := by linarith
  have ha_i₀ : a (ψ 0) i₀ = φ (τ (ψ 0)) := h_inj hlam_eq
  -- Step F: Reconstruct s' (τ (ψ 0)) = φ (τ (ψ 0)) ::ₘ s, contradiction
  have hs'_eq : s' (τ (ψ 0)) = φ (τ (ψ 0)) ::ₘ s := by
    rw [← ha (ψ 0), huniv_eq, Finset.insert_val_of_notMem hi₀_not_mem, Multiset.map_cons, ha_i₀]
    congr 1
    have hmap_eq : I.val.map (a (ψ 0)) = I.val.map c :=
      Multiset.map_congr rfl fun i hi => hψ_const i hi 0
    rw [hmap_eq]
    exact hs₀_eq_s
  exact hs'_ne (τ (ψ 0)) hs'_eq

/-- For `k ≥ 1`, any sum with a unique `≤ k`-representation of exact cardinality `k` is nonzero. -/
theorem hasUniqueRep_sum_ne_zero {lam : ℕ → ℝ} {k : ℕ} (hk : 1 ≤ k) {t : ℝ} {s : Multiset ℕ}
    (h_rep : HasUniqueRep lam k t s) (h_card : s.card = k) : t ≠ 0 := by
  intro ht0
  have h0_eq : (0 : Multiset ℕ) = s := h_rep.2.2 0 (Nat.zero_le k) (by simp [ht0])
  have hcard0 : (0 : Multiset ℕ).card = s.card := congrArg Multiset.card h0_eq
  simp [h_card] at hcard0
  omega

/-- Cofinite extension also avoids every element of the finite multiset `s`, producing distinct
atoms and a strictly nonzero sum. -/
theorem uniqueSum_extension_cofinite_distinct {lam : ℕ → ℝ}
    (h_inj : Function.Injective lam) (h_ne : ∀ n, lam n ≠ 0)
    (h_lim : Tendsto lam atTop (nhds 0))
    {k : ℕ} {t : ℝ} {s : Multiset ℕ}
    (h_rep : HasUniqueRep lam k t s) (h_card : s.card = k) :
    ∀ᶠ n in atTop,
      n ∉ s ∧
      HasUniqueRep lam (k + 1) (t + lam n) (n ::ₘ s) ∧
      (n ::ₘ s).card = k + 1 ∧
      t + lam n ≠ 0 := by
  have h1 := uniqueSum_extension_cofinite h_inj h_ne h_lim h_rep h_card
  have h2 : ∀ᶠ n in atTop, n ∉ s := by
    rw [Filter.eventually_atTop]
    refine ⟨s.toFinset.sup id + 1, fun n hn hmem => ?_⟩
    have hmem' : n ∈ s.toFinset := Multiset.mem_toFinset.mpr hmem
    have hle : n ≤ s.toFinset.sup id := Finset.le_sup (f := id) hmem'
    omega
  filter_upwards [h1, h2] with n ⟨hrep', hcard'⟩ hnotmem
  exact ⟨hnotmem, hrep', hcard',
    hasUniqueRep_sum_ne_zero (Nat.succ_pos k) hrep' hcard'⟩

/-- An admissible prefix of length `k` for the unique-sum tree: pairwise distinct indices whose
`lam`-sum has a unique `≤ k`-representation. -/
def IsUniqueSumPrefix (lam : ℕ → ℝ) (k : ℕ) (p : Fin k → ℕ) : Prop :=
  Function.Injective p ∧
    HasUniqueRep lam k (∑ i : Fin k, lam (p i)) (Finset.univ.val.map p)

/-- A `D`-level cofinite-branching tree of index tuples `Fin k → ℕ` (`k ≤ D`). -/
structure CofiniteBranchingTree (D : ℕ) where
  /-- Admissibility predicate at depth `k ≤ D`. -/
  admissible : ∀ k ≤ D, (Fin k → ℕ) → Prop
  /-- The empty prefix is admissible at the root. -/
  root : admissible 0 (Nat.zero_le D) Fin.elim0
  /-- Every admissible prefix of length `k < D` admits cofinitely many valid extensions. -/
  extend_cofinite : ∀ k (hk : k < D) (p : Fin k → ℕ),
    admissible k hk.le p → ∀ᶠ n in atTop, admissible (k + 1) hk (Fin.snoc p n)

lemma isUniqueSumPrefix_zero (lam : ℕ → ℝ) :
    IsUniqueSumPrefix lam 0 Fin.elim0 := by
  refine ⟨fun i => Fin.elim0 i, ?_, ?_, ?_⟩
  · simp
  · simp
  · intro s' hs' _
    exact Multiset.card_eq_zero.mp (Nat.le_zero.mp hs')

lemma multiset_map_snoc {α : Type*} {k : ℕ} (p : Fin k → α) (x : α) :
    Finset.univ.val.map (Fin.snoc (α := fun _ => α) p x) = x ::ₘ Finset.univ.val.map p := by
  have huniv : (Finset.univ : Finset (Fin (k + 1))) =
      insert (Fin.last k) (Finset.univ.map Fin.castSuccEmb) := by
    ext i
    simp only [Finset.mem_univ, Finset.mem_insert, Finset.mem_map, Fin.castSuccEmb_apply, true_iff]
    refine Fin.lastCases (Or.inl rfl) (fun j => Or.inr ⟨j, trivial, rfl⟩) i
  have hnotmem : Fin.last k ∉ (Finset.univ : Finset (Fin k)).map Fin.castSuccEmb := by
    simp only [Finset.mem_map, Finset.mem_univ, true_and, Fin.castSuccEmb_apply, not_exists]
    intro j hj
    exact Fin.castSucc_ne_last j hj
  rw [huniv, Finset.insert_val_of_notMem hnotmem, Multiset.map_cons, Fin.snoc_last]
  congr 1
  rw [Finset.map_val, Multiset.map_map]
  exact Multiset.map_congr rfl fun j _ => by simp

/-- Every unique-sum prefix `p` of length `k` extends cofinitely to `Fin.snoc p n` with distinct
entries, unique `≤ (k + 1)`-representation, and nonzero sum. -/
theorem isUniqueSumPrefix_extend_cofinite {lam : ℕ → ℝ}
    (h_inj : Function.Injective lam) (h_ne : ∀ n, lam n ≠ 0)
    (h_lim : Tendsto lam atTop (nhds 0))
    {k : ℕ} {p : Fin k → ℕ} (hp : IsUniqueSumPrefix lam k p) :
    ∀ᶠ n in atTop,
      IsUniqueSumPrefix lam (k + 1) (Fin.snoc (α := fun _ => ℕ) p n) ∧
      ∑ i : Fin (k + 1), lam (Fin.snoc (α := fun _ => ℕ) p n i) ≠ 0 := by
  have hcard : (Finset.univ.val.map p).card = k := by simp
  have hext := uniqueSum_extension_cofinite_distinct h_inj h_ne h_lim hp.2 hcard
  filter_upwards [hext] with n ⟨hnotmem, hrep', _, hsum_ne⟩
  let p' : Fin (k + 1) → ℕ := Fin.snoc p n
  have hsnoc_sum : ∑ i : Fin (k + 1), lam (p' i) = (∑ i : Fin k, lam (p i)) + lam n := by
    rw [Fin.sum_univ_castSucc]
    simp [p']
  have hsnoc_inj : Function.Injective p' := by
    intro i j hij
    revert hij
    refine Fin.lastCases ?_ (fun i' => ?_) i <;> refine Fin.lastCases ?_ (fun j' => ?_) j
    · intro _; rfl
    · intro hij
      simp only [p', Fin.snoc_last, Fin.snoc_castSucc] at hij
      exact absurd (Multiset.mem_map.mpr ⟨j', Finset.mem_univ j', hij.symm⟩) hnotmem
    · intro hij
      simp only [p', Fin.snoc_castSucc, Fin.snoc_last] at hij
      exact absurd (Multiset.mem_map.mpr ⟨i', Finset.mem_univ i', hij⟩) hnotmem
    · intro hij
      simp only [p', Fin.snoc_castSucc] at hij
      exact congrArg Fin.castSucc (hp.1 hij)
  refine ⟨⟨hsnoc_inj, ?_⟩, hsnoc_sum ▸ hsum_ne⟩
  rw [hsnoc_sum, multiset_map_snoc]
  exact hrep'

/-- The canonical depth-`D` unique-sum cofinite-branching tree for `lam`. -/
def uniqueSumTree {lam : ℕ → ℝ}
    (h_inj : Function.Injective lam) (h_ne : ∀ n, lam n ≠ 0)
    (h_lim : Tendsto lam atTop (nhds 0)) (D : ℕ) : CofiniteBranchingTree D where
  admissible k _ p := IsUniqueSumPrefix lam k p
  root := isUniqueSumPrefix_zero lam
  extend_cofinite k _ p hp := by
    filter_upwards [isUniqueSumPrefix_extend_cofinite h_inj h_ne h_lim hp] with n hn
    exact hn.1

/-- **Unique-Sum Tree Existence & Nonzero Sum Theorem:**
For every `D : ℕ`, there exists a cofinite-branching tree of depth `D` whose admissible tuples
at every level `k ≤ D` have pairwise distinct entries, unique `≤ k`-representation sums, and
strictly nonzero sums whenever `k ≥ 1` (in particular, never colliding with `0` for `D ≥ 1`). -/
theorem uniqueSum_tree_exists {lam : ℕ → ℝ}
    (h_inj : Function.Injective lam) (h_ne : ∀ n, lam n ≠ 0)
    (h_lim : Tendsto lam atTop (nhds 0)) (D : ℕ) :
    ∃ T : CofiniteBranchingTree D,
      (∀ k (hk : k ≤ D) (p : Fin k → ℕ), T.admissible k hk p → IsUniqueSumPrefix lam k p) ∧
      (∀ k (hk : k ≤ D) (_ : 1 ≤ k) (p : Fin k → ℕ),
        T.admissible k hk p → ∑ i : Fin k, lam (p i) ≠ 0) := by
  refine ⟨uniqueSumTree h_inj h_ne h_lim D, fun _ _ _ hp => hp, ?_⟩
  intro k _ hk1 p hp
  exact hasUniqueRep_sum_ne_zero hk1 hp.2 (by simp)

/-- Lower-degree tuples (`k < D`) can never collide with an admissible unique-sum `D`-tuple. -/
theorem uniqueSum_no_lower_collision {lam : ℕ → ℝ} {D k : ℕ} (hk : k < D)
    {p : Fin D → ℕ} (hp : IsUniqueSumPrefix lam D p) (q : Fin k → ℕ) :
    ∑ i : Fin k, lam (q i) ≠ ∑ i : Fin D, lam (p i) := by
  intro heq
  have hms : Finset.univ.val.map q = Finset.univ.val.map p :=
    hp.2.2.2 (Finset.univ.val.map q) (by simp [hk.le]) (by rw [multiset_map_univ_sum]; exact heq)
  have hcard : (Finset.univ.val.map q).card = (Finset.univ.val.map p).card :=
    congrArg Multiset.card hms
  simp at hcard
  omega

/-- Degree-`D` collisions with an admissible unique-sum `D`-tuple `p` are precisely the `D!`
permutations `p ∘ σ` (`σ : Equiv.Perm (Fin D)`). -/
theorem uniqueSum_perm_collisions {lam : ℕ → ℝ} {D : ℕ}
    {p : Fin D → ℕ} (hp : IsUniqueSumPrefix lam D p) (q : Fin D → ℕ) :
    (∑ i : Fin D, lam (q i) = ∑ i : Fin D, lam (p i)) ↔
      ∃ σ : Equiv.Perm (Fin D), q = p ∘ σ := by
  constructor
  · intro heq
    have hms : Finset.univ.val.map q = Finset.univ.val.map p :=
      hp.2.2.2 (Finset.univ.val.map q) (by simp) (by rw [multiset_map_univ_sum]; exact heq)
    have hnodup_p : (Finset.univ.val.map p).Nodup :=
      Multiset.Nodup.map hp.1 Finset.univ.nodup
    have hnodup_q : (Finset.univ.val.map q).Nodup := hms ▸ hnodup_p
    have hq_inj : Function.Injective q := by
      intro i j hij
      by_contra hne
      have hsub : ({i, j} : Finset (Fin D)).val ≤ (Finset.univ : Finset (Fin D)).val :=
        Finset.val_le_iff.mpr (Finset.subset_univ _)
      have hcount : Multiset.count (q i) (Finset.univ.val.map q) ≥ 2 := by
        have hle := Multiset.count_le_of_le (q i) (Multiset.map_le_map (f := q) hsub)
        have hpair : ({i, j} : Finset (Fin D)).val = i ::ₘ {j} := by
          rw [Finset.insert_val_of_notMem (by simp [hne])]
          rfl
        rw [hpair, Multiset.map_cons, Multiset.map_singleton,
            Multiset.count_cons_self, Multiset.count_singleton] at hle
        simp only [hij, ite_true] at hle
        rw [hij]
        exact hle
      have hle1 := Multiset.nodup_iff_count_le_one.mp hnodup_q (q i)
      omega
    have hmem : ∀ i : Fin D, ∃ j : Fin D, p j = q i := fun i => by
      have h1 : q i ∈ Finset.univ.val.map q := Multiset.mem_map.mpr ⟨i, Finset.mem_univ i, rfl⟩
      rw [hms] at h1
      obtain ⟨j, _, hj⟩ := Multiset.mem_map.mp h1
      exact ⟨j, hj⟩
    choose f hf using hmem
    have hf_inj : Function.Injective f := fun i j hij =>
      hq_inj (by rw [← hf i, ← hf j, hij])
    have hf_bij : Function.Bijective f := Finite.injective_iff_bijective.mp hf_inj
    refine ⟨Equiv.ofBijective f hf_bij, ?_⟩
    funext i
    exact (hf i).symm
  · rintro ⟨σ, rfl⟩
    exact Equiv.sum_comp σ (fun i => lam (p i))

/-- **Exact Codex Equation (8.2) Fourier-Coefficient Extraction:**
Summing a symmetric `D`-variable function `B (v ∘ q)` over all `q : Fin D → ℕ` inside any finite
window `F` covering `p` whose `lam`-sum equals `∑ i, lam (p i)` yields exactly
`D! • B (v ∘ p)`. -/
theorem uniqueSum_symm_sum_eq_factorial_mul {K V : Type*} [CommRing K] [AddCommGroup V]
    [Module K V] {lam : ℕ → ℝ} {D : ℕ}
    {p : Fin D → ℕ} (hp : IsUniqueSumPrefix lam D p)
    (v : ℕ → V) (B : (Fin D → V) → K)
    (hB_symm : ∀ (σ : Equiv.Perm (Fin D)) (x : Fin D → V), B (x ∘ σ) = B x)
    (F : Finset ℕ) (hpF : ∀ i : Fin D, p i ∈ F) :
    ∑ q ∈ (Fintype.piFinset fun _ : Fin D => F).filter
        (fun q => ∑ i : Fin D, lam (q i) = ∑ i : Fin D, lam (p i)),
      B (v ∘ q) = (D.factorial : K) * B (v ∘ p) := by
  let S := (Fintype.piFinset fun _ : Fin D => F).filter
    (fun q => ∑ i : Fin D, lam (q i) = ∑ i : Fin D, lam (p i))
  let emb : Equiv.Perm (Fin D) ↪ (Fin D → ℕ) :=
    ⟨fun σ => p ∘ σ, fun σ₁ σ₂ h => Equiv.ext fun i => hp.1 (congrFun h i)⟩
  have hS_eq : S = Finset.univ.map emb := by
    ext q
    simp only [S, Finset.mem_filter, Fintype.mem_piFinset, Finset.mem_map, Finset.mem_univ,
      true_and, emb]
    constructor
    · rintro ⟨_, hsum⟩
      obtain ⟨σ, rfl⟩ := (uniqueSum_perm_collisions hp q).mp hsum
      exact ⟨σ, rfl⟩
    · rintro ⟨σ, rfl⟩
      exact ⟨fun i => hpF (σ i), (uniqueSum_perm_collisions hp (p ∘ σ)).mpr ⟨σ, rfl⟩⟩
  change ∑ q ∈ S, B (v ∘ q) = (D.factorial : K) * B (v ∘ p)
  rw [hS_eq, Finset.sum_map]
  have hconst : ∀ σ ∈ (Finset.univ : Finset (Equiv.Perm (Fin D))),
      B (v ∘ emb σ) = B (v ∘ p) := fun σ _ => hB_symm σ (v ∘ p)
  rw [Finset.sum_congr rfl hconst, Finset.sum_const, Finset.card_univ, Fintype.card_perm,
      Fintype.card_fin, nsmul_eq_mul]

end UniqueSumTree

/-! ### 2. Symmetric Multilinear Polarization Vanishing & Vandermonde Tail-Span -/

section PolarizationAndVandermonde

private lemma snoc_update_castSucc {α : Type*} {D : ℕ}
    [DecidableEq (Fin D)] [DecidableEq (Fin (D + 1))]
    (x : Fin D → α) (w : α) (i : Fin D) (u : α) :
    (Fin.snoc (Function.update x i u) w : Fin (D + 1) → α) =
      Function.update (Fin.snoc x w : Fin (D + 1) → α) i.castSucc u := by
  funext j
  refine Fin.lastCases (by simp [(Fin.castSucc_ne_last i).symm]) (fun j' => ?_) j
  by_cases hji : j' = i
  · subst hji; simp
  · simp [hji, Fin.castSucc_inj]

private lemma snoc_eq_update_last {α : Type*} [Zero α] {D : ℕ}
    [DecidableEq (Fin (D + 1))] (x : Fin D → α) (u : α) :
    (Fin.snoc x u : Fin (D + 1) → α) =
      Function.update (Fin.snoc x 0 : Fin (D + 1) → α) (Fin.last D) u := by
  funext j
  refine Fin.lastCases (by simp) (fun j' => by simp [Fin.castSucc_ne_last]) j

/-- **Multilinear Polarization Vanishing Lemma:**
If a `D`-linear map `B` vanishes on `v ∘ p` along a cofinite-branching tree of depth `D`, and
every cofinite tail of `v : ℕ → V` spans `V`, then `B = 0` identically (and hence the
homogeneous degree-`D` polynomial `x ↦ B (fun _ => x)` vanishes identically). -/
theorem polarization_vanish_of_cofinite_span {K V W : Type*}
    [CommSemiring K] [AddCommMonoid V] [Module K V] [AddCommMonoid W] [Module K W] :
    ∀ {D : ℕ} (T : CofiniteBranchingTree D) (v : ℕ → V)
      (_hspan : ∀ N : ℕ, Submodule.span K (v '' Set.Ici N) = ⊤)
      (B : (Fin D → V) →ₘₗ[K] W)
      (_hvanish : ∀ p : Fin D → ℕ, T.admissible D le_rfl p → B (v ∘ p) = 0),
      B = 0
  | 0, T, v, _, B, hvanish => by
    ext x
    have hx : x = v ∘ Fin.elim0 := Subsingleton.elim _ _
    rw [hx, zero_apply]
    exact hvanish Fin.elim0 T.root
  | D + 1, T, v, hspan, B, hvanish => by
    let T' : CofiniteBranchingTree D :=
      { admissible := fun k hk => T.admissible k (hk.trans (Nat.le_succ D))
        root := T.root
        extend_cofinite := fun k hk p hp =>
          T.extend_cofinite k (lt_trans hk (Nat.lt_succ_self D)) p hp }
    have hslice_zero : ∀ w : V, ∀ x : Fin D → V, B (Fin.snoc x w) = 0 := by
      intro w
      let Bw : (Fin D → V) →ₘₗ[K] W :=
        { toFun := fun x => B (Fin.snoc x w)
          map_update_add' := fun x i u₁ u₂ => by
            rw [snoc_update_castSucc, snoc_update_castSucc, snoc_update_castSucc,
                B.map_update_add]
          map_update_smul' := fun x i c u => by
            rw [snoc_update_castSucc, snoc_update_castSucc, B.map_update_smul] }
      have hBw_vanish : ∀ p : Fin D → ℕ, T'.admissible D le_rfl p → Bw (v ∘ p) = 0 := by
        intro p hp
        obtain ⟨N, hN⟩ := Filter.eventually_atTop.mp (T.extend_cofinite D (Nat.lt_succ_self D) p hp)
        let L : V →ₗ[K] W :=
          { toFun := fun u => B (Fin.snoc (v ∘ p) u)
            map_add' := fun u₁ u₂ => by
              calc B (Fin.snoc (v ∘ p) (u₁ + u₂))
                  = B (Function.update (Fin.snoc (v ∘ p) 0) (Fin.last D) (u₁ + u₂)) := by
                    rw [← snoc_eq_update_last]
                _ = B (Function.update (Fin.snoc (v ∘ p) 0) (Fin.last D) u₁) +
                    B (Function.update (Fin.snoc (v ∘ p) 0) (Fin.last D) u₂) :=
                    B.map_update_add _ _ _ _
                _ = B (Fin.snoc (v ∘ p) u₁) + B (Fin.snoc (v ∘ p) u₂) := by
                    rw [← snoc_eq_update_last, ← snoc_eq_update_last]
            map_smul' := fun c u => by
              calc B (Fin.snoc (v ∘ p) (c • u))
                  = B (Function.update (Fin.snoc (v ∘ p) 0) (Fin.last D) (c • u)) := by
                    rw [← snoc_eq_update_last]
                _ = c • B (Function.update (Fin.snoc (v ∘ p) 0) (Fin.last D) u) := by
                    simp [B.map_update_smul]
                _ = c • B (Fin.snoc (v ∘ p) u) := by
                    rw [← snoc_eq_update_last] }
        have hker : v '' Set.Ici N ⊆ (LinearMap.ker L : Set V) := by
          rintro _ ⟨n, hn, rfl⟩
          change B (Fin.snoc (v ∘ p) (v n)) = 0
          have hcomp : Fin.snoc (α := fun _ => V) (v ∘ p) (v n) = v ∘ Fin.snoc p n := by
            funext j
            refine Fin.lastCases (by simp) (fun j' => by simp) j
          rw [hcomp]
          exact hvanish (Fin.snoc p n) (hN n hn)
        have htop : LinearMap.ker L = ⊤ :=
          eq_top_iff.mpr (hspan N ▸ Submodule.span_le.mpr hker)
        have hw_mem : w ∈ LinearMap.ker L := htop ▸ Submodule.mem_top
        exact hw_mem
      have hBw_zero : Bw = 0 := polarization_vanish_of_cofinite_span T' v hspan Bw hBw_vanish
      intro x
      exact congrArg (fun f : (Fin D → V) →ₘₗ[K] W => f x) hBw_zero
    ext y
    rw [zero_apply, ← Fin.snoc_init_self y]
    exact hslice_zero (y (Fin.last D)) (Fin.init y)

/-- Diagonal vanishing corollary of `polarization_vanish_of_cofinite_span`. -/
theorem polarization_diag_vanish_of_cofinite_span {K V W : Type*}
    [CommSemiring K] [AddCommMonoid V] [Module K V] [AddCommMonoid W] [Module K W]
    {D : ℕ} (T : CofiniteBranchingTree D) (v : ℕ → V)
    (hspan : ∀ N : ℕ, Submodule.span K (v '' Set.Ici N) = ⊤)
    (B : (Fin D → V) →ₘₗ[K] W)
    (hvanish : ∀ p : Fin D → ℕ, T.admissible D le_rfl p → B (v ∘ p) = 0)
    (x : V) : B (fun _ => x) = 0 := by
  rw [polarization_vanish_of_cofinite_span T v hspan B hvanish, zero_apply]

/-- Canonical `D`-tuple of variable indices realizing a multi-index `d : Fin m →₀ ℕ` of total
degree `D`: each variable `j : Fin m` appears exactly `d j` times. -/
private def monomialIndexList {m : ℕ} (d : Fin m →₀ ℕ) : List (Fin m) :=
  (List.finRange m).flatMap fun j => List.replicate (d j) j

private lemma list_prod_flatMap {α β : Type*} [CommMonoid β] (l : List α) (f : α → List β) :
    (l.flatMap f).prod = (l.map fun a => (f a).prod).prod := by
  induction l with
  | nil => simp
  | cons a t ih => simp [List.flatMap_cons, List.prod_append, ih]

private lemma list_sum_map_finRange {M : Type*} [AddCommMonoid M] {m : ℕ} (f : Fin m → M) :
    ((List.finRange m).map f).sum = ∑ j : Fin m, f j := by
  change (Multiset.map f (List.finRange m : Multiset (Fin m))).sum = ∑ j : Fin m, f j
  rfl

private lemma list_prod_map_finRange {M : Type*} [CommMonoid M] {m : ℕ} (f : Fin m → M) :
    ((List.finRange m).map f).prod = ∏ j : Fin m, f j := by
  change (Multiset.map f (List.finRange m : Multiset (Fin m))).prod = ∏ j : Fin m, f j
  rfl

private lemma monomialIndexList_length {m : ℕ} (d : Fin m →₀ ℕ) :
    (monomialIndexList d).length = d.sum (fun _ k => k) := by
  unfold monomialIndexList
  rw [List.length_flatMap]
  have hmap : ((List.finRange m).map fun j => (List.replicate (d j) j).length).sum =
      ∑ j : Fin m, d j := by
    simpa [List.length_replicate] using list_sum_map_finRange (fun j : Fin m => d j)
  rw [hmap, Finsupp.sum_fintype]
  intro _; rfl

private lemma prod_monomialIndexList {K : Type*} [CommRing K] {m : ℕ}
    (d : Fin m →₀ ℕ) (x : Fin m → K) :
    ((monomialIndexList d).map x).prod = ∏ j : Fin m, (x j) ^ (d j) := by
  unfold monomialIndexList
  rw [List.map_flatMap, list_prod_flatMap]
  have h1 : ∀ j : Fin m, ((List.replicate (d j) j).map x).prod = (x j) ^ (d j) := fun j => by
    rw [List.map_replicate, List.prod_replicate]
  have h2 : ((List.finRange m).map fun j => ((List.replicate (d j) j).map x).prod).prod =
      ((List.finRange m).map fun j => (x j) ^ (d j)).prod := by
    congr 1
    exact List.map_congr_left fun j _ => h1 j
  rw [h2, list_prod_map_finRange]

/-- Product `D`-linear map `(v₀, ..., v_{D-1}) ↦ ∏ i, v i (idx i)`. -/
def coordProdMultilinear (K : Type*) [CommRing K] {m D : ℕ} (idx : Fin D → Fin m) :
    (Fin D → (Fin m → K)) →ₘₗ[K] K where
  toFun v := ∏ i : Fin D, v i (idx i)
  map_update_add' v i u₁ u₂ := by
    rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i),
        ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i),
        ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i)]
    simp only [Function.update_self, Pi.add_apply]
    have hrest : ∀ (u : Fin m → K),
        ∏ j ∈ Finset.univ.erase i, Function.update v i u j (idx j) =
          ∏ j ∈ Finset.univ.erase i, v j (idx j) := fun u =>
      Finset.prod_congr rfl fun j hj => by
        rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)]
    rw [hrest, hrest, hrest]
    ring
  map_update_smul' v i c u := by
    rw [← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i),
        ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ i)]
    simp only [Function.update_self, Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    have hrest : ∀ (w : Fin m → K),
        ∏ j ∈ Finset.univ.erase i, Function.update v i w j (idx j) =
          ∏ j ∈ Finset.univ.erase i, v j (idx j) := fun w =>
      Finset.prod_congr rfl fun j hj => by
        rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)]
    rw [hrest, hrest]
    ring

/-- Symmetrized `D`-linear polarization of a single monomial of total degree `D`. -/
def monomialPolar (K : Type*) [Field K] {m D : ℕ} (d : Fin m →₀ ℕ)
    (hd : d.sum (fun _ k => k) = D) :
    (Fin D → (Fin m → K)) →ₘₗ[K] K :=
  let idx : Fin D → Fin m := fun i =>
    (monomialIndexList d).get (i.cast ((monomialIndexList_length d).trans hd).symm)
  ((D.factorial : K)⁻¹) • ∑ σ : Equiv.Perm (Fin D),
    coordProdMultilinear K (idx ∘ σ)

/-- Explicit symmetric `D`-linear polarization of a homogeneous degree-`D` multivariate polynomial
over a characteristic-zero field `K`. -/
def homogPolarize {K : Type*} [Field K] {m : ℕ} (D : ℕ) (P : MvPolynomial (Fin m) K) :
    (Fin D → (Fin m → K)) →ₘₗ[K] K :=
  ∑ d ∈ P.support,
    if hd : d.sum (fun _ k => k) = D then
      (P.coeff d) • monomialPolar K d hd
    else 0

lemma monomialPolar_symm {K : Type*} [Field K] {m D : ℕ}
    (d : Fin m →₀ ℕ) (hd : d.sum (fun _ k => k) = D)
    (τ : Equiv.Perm (Fin D)) (v : Fin D → (Fin m → K)) :
    monomialPolar K d hd (v ∘ τ) = monomialPolar K d hd v := by
  unfold monomialPolar
  simp only [smul_apply, sum_apply, smul_eq_mul]
  congr 1
  let idx : Fin D → Fin m := fun i =>
    (monomialIndexList d).get (i.cast ((monomialIndexList_length d).trans hd).symm)
  have hterm : ∀ σ : Equiv.Perm (Fin D),
      coordProdMultilinear K (idx ∘ σ) (v ∘ τ) =
        coordProdMultilinear K (idx ∘ (σ * τ⁻¹)) v := fun σ => by
    change ∏ i : Fin D, v (τ i) (idx (σ i)) = ∏ i : Fin D, v i (idx (σ (τ⁻¹ i)))
    rw [← Equiv.prod_comp τ (fun j => v j (idx (σ (τ⁻¹ j))))]
    exact Finset.prod_congr rfl fun i _ => by simp
  rw [Finset.sum_congr rfl fun σ _ => hterm σ]
  exact Equiv.sum_comp (Equiv.mulRight τ⁻¹)
    (fun σ => coordProdMultilinear K (idx ∘ σ) v)

/-- `homogPolarize D P` is totally symmetric under all permutations of its `D` arguments. -/
theorem homogPolarize_symm {K : Type*} [Field K] {m : ℕ} (D : ℕ)
    (P : MvPolynomial (Fin m) K) (τ : Equiv.Perm (Fin D)) (v : Fin D → (Fin m → K)) :
    homogPolarize D P (v ∘ τ) = homogPolarize D P v := by
  unfold homogPolarize
  simp only [sum_apply]
  refine Finset.sum_congr rfl fun d _ => ?_
  split_ifs with hd
  · simp only [smul_apply, smul_eq_mul]
    rw [monomialPolar_symm d hd τ v]
  · simp

lemma monomialPolar_diag {K : Type*} [Field K] [CharZero K] {m D : ℕ}
    (d : Fin m →₀ ℕ) (hd : d.sum (fun _ k => k) = D) (x : Fin m → K) :
    monomialPolar K d hd (fun _ => x) = ∏ j : Fin m, (x j) ^ (d j) := by
  unfold monomialPolar
  simp only [smul_apply, sum_apply, smul_eq_mul]
  let idx : Fin D → Fin m := fun i =>
    (monomialIndexList d).get (i.cast ((monomialIndexList_length d).trans hd).symm)
  have hprod : ∀ σ : Equiv.Perm (Fin D),
      coordProdMultilinear K (idx ∘ σ) (fun _ => x) = ∏ j : Fin m, (x j) ^ (d j) := fun σ => by
    change ∏ i : Fin D, x (idx (σ i)) = ∏ j : Fin m, (x j) ^ (d j)
    rw [Equiv.prod_comp σ (fun i => x (idx i))]
    have hofFn : (List.ofFn fun i : Fin D => x (idx i)) = (monomialIndexList d).map x := by
      apply List.ext_getElem
      · simp [monomialIndexList_length, hd]
      · intro n hn1 hn2
        simp [idx]
    rw [← prod_monomialIndexList d x, ← hofFn, List.prod_ofFn]
  rw [Finset.sum_congr rfl fun σ _ => hprod σ, Finset.sum_const, Finset.card_univ,
      Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
  have hfac_ne : (D.factorial : K) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero D)
  field_simp [hfac_ne]

/-- On the diagonal `(x, ..., x)`, `homogPolarize D P` recovers `MvPolynomial.eval x P` for every
homogeneous polynomial `P` of degree `D`. -/
theorem homogPolarize_diag {K : Type*} [Field K] [CharZero K] {m : ℕ} (D : ℕ)
    {P : MvPolynomial (Fin m) K} (hP : P.IsHomogeneous D) (x : Fin m → K) :
    homogPolarize D P (fun _ => x) = MvPolynomial.eval x P := by
  unfold homogPolarize
  simp only [sum_apply]
  rw [MvPolynomial.eval_eq']
  refine Finset.sum_congr rfl fun d hd_supp => ?_
  have hd_deg : d.sum (fun _ k => k) = D := by
    by_contra hne
    have hcoeff0 : P.coeff d = 0 := hP.coeff_eq_zero hne
    exact (MvPolynomial.mem_support_iff.mp hd_supp) hcoeff0
  split_ifs
  simp only [smul_apply, smul_eq_mul]
  rw [monomialPolar_diag d hd_deg x]

/-- If the polarization of a homogeneous degree-`D` polynomial `P` vanishes along a
cofinite-branching tree on a vector sequence whose every cofinite tail spans `Fin m → K`, then
`P = 0` identically. -/
theorem homogPoly_eq_zero_of_cofinite_tree_vanish {K : Type*} [Field K] [CharZero K]
    {m D : ℕ} (T : CofiniteBranchingTree D) (v : ℕ → (Fin m → K))
    (hspan : ∀ N : ℕ, Submodule.span K (v '' Set.Ici N) = ⊤)
    {P : MvPolynomial (Fin m) K} (hP : P.IsHomogeneous D)
    (hvanish : ∀ p : Fin D → ℕ, T.admissible D le_rfl p → homogPolarize D P (v ∘ p) = 0) :
    P = 0 := by
  apply MvPolynomial.funext
  intro x
  rw [map_zero, ← homogPolarize_diag D hP x]
  exact polarization_diag_vanish_of_cofinite_span T v hspan (homogPolarize D P) hvanish x

/-- Helper extracting `n` strictly increasing indices `≥ N` from an infinite tail property. -/
private lemma exists_strictMono_fin_of_inf_tail {P : ℕ → Prop}
    (hinf : ∀ N, ∃ m ≥ N, P m) (N : ℕ) :
    ∀ n : ℕ, ∃ idx : Fin n → ℕ, StrictMono idx ∧ ∀ i : Fin n, N ≤ idx i ∧ P (idx i)
  | 0 => ⟨Fin.elim0, fun i => Fin.elim0 i, fun i => Fin.elim0 i⟩
  | n + 1 => by
    obtain ⟨idx, hmono, hP⟩ := exists_strictMono_fin_of_inf_tail hinf N n
    let bound : ℕ := max N ((Finset.univ.sup idx) + 1)
    obtain ⟨m, hm_ge, hm_P⟩ := hinf bound
    refine ⟨Fin.snoc idx m, ?_, ?_⟩
    · intro i j hij
      revert hij
      refine Fin.lastCases ?_ (fun i' => ?_) i <;> refine Fin.lastCases ?_ (fun j' => ?_) j
      · intro hij; exact absurd hij (lt_irrefl _)
      · intro hij; exact absurd hij (not_lt.mpr (Fin.le_last _))
      · intro _
        simp only [Fin.snoc_castSucc, Fin.snoc_last]
        have hle : idx i' ≤ Finset.univ.sup idx := Finset.le_sup (f := idx) (Finset.mem_univ i')
        have hlt : Finset.univ.sup idx < m :=
          lt_of_lt_of_le (Nat.lt_succ_self _) (le_trans (le_max_right N _) hm_ge)
        exact lt_of_le_of_lt hle hlt
      · intro hij
        simp only [Fin.snoc_castSucc]
        exact hmono (Fin.castSucc_lt_castSucc_iff.mp hij)
    · intro i
      refine Fin.lastCases ?_ (fun i' => ?_) i
      · simp only [Fin.snoc_last]
        exact ⟨le_trans (le_max_left N _) hm_ge, hm_P⟩
      · simp only [Fin.snoc_castSucc]
        exact hP i'

/-- **Vandermonde Tail-Span Lemma (general field `K`):**
For any injective sequence `lam : ℕ → K` and sequence `a : ℕ → K` with `a m ≠ 0` infinitely often,
every cofinite tail of `m ↦ a m • (1, lam m, ..., (lam m)^r)` spans `Fin (r + 1) → K`. -/
theorem vandermonde_tail_span {K : Type*} [Field K]
    (r : ℕ) {lam a : ℕ → K}
    (h_inj : Function.Injective lam)
    (h_inf : ∀ N : ℕ, ∃ m ≥ N, a m ≠ 0) (N : ℕ) :
    Submodule.span K
      ((fun m (j : Fin (r + 1)) => a m * (lam m) ^ (j : ℕ)) '' Set.Ici N) = ⊤ := by
  obtain ⟨idx, hmono, hidx⟩ := exists_strictMono_fin_of_inf_tail h_inf N (r + 1)
  let v : ℕ → (Fin (r + 1) → K) := fun m j => a m * (lam m) ^ (j : ℕ)
  let M : Matrix (Fin (r + 1)) (Fin (r + 1)) K := Matrix.of fun i j => v (idx i) j
  have hM_eq : M = Matrix.diagonal (fun i => a (idx i)) *
      Matrix.vandermonde (fun i => lam (idx i)) := by
    ext i j
    simp [M, v, Matrix.diagonal_mul, Matrix.vandermonde_apply]
  have hdet_ne : M.det ≠ 0 := by
    rw [hM_eq, Matrix.det_mul, Matrix.det_diagonal]
    refine mul_ne_zero ?_ ?_
    · exact Finset.prod_ne_zero_iff.mpr fun i _ => (hidx i).2
    · exact Matrix.det_vandermonde_ne_zero_iff.mpr fun i j hij =>
        h_inj.comp hmono.injective hij
  have hunit : IsUnit M.det := isUnit_iff_ne_zero.mpr hdet_ne
  rw [eq_top_iff]
  intro w _
  let c : Fin (r + 1) → K := w ᵥ* M⁻¹
  have hw_eq : w = ∑ i : Fin (r + 1), c i • v (idx i) := by
    have hmul : c ᵥ* M = w := by
      simp only [c, Matrix.vecMul_vecMul, Matrix.nonsing_inv_mul _ hunit, Matrix.vecMul_one]
    funext j
    have hj := congrFun hmul j
    simpa [Matrix.vecMul, dotProduct, M, Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hj.symm
  rw [hw_eq]
  refine Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ (c i) ?_
  exact Submodule.subset_span ⟨idx i, (hidx i).1, rfl⟩

/-- **Vandermonde Tail-Span Lemma over `ℂ`:**
For any injective sequence `lam : ℕ → ℂ` and `a : ℕ → ℂ` with `a m ≠ 0` infinitely often,
every cofinite tail of `a_m • (1, λ_m, ..., λ_m^r)` spans `Fin (r + 1) → ℂ`. -/
theorem vandermonde_tail_span_complex
    (r : ℕ) {lam a : ℕ → ℂ}
    (h_inj : Function.Injective lam)
    (h_inf : ∀ N : ℕ, ∃ m ≥ N, a m ≠ 0) (N : ℕ) :
    Submodule.span ℂ
      ((fun m (j : Fin (r + 1)) => a m * (lam m) ^ (j : ℕ)) '' Set.Ici N) = ⊤ :=
  vandermonde_tail_span r h_inj h_inf N

/-- **End-to-End Theorem 8.1 Combinatorial Core:**
Given real distinct nonzero frequencies `lam : ℕ → ℝ` tending to `0`, nonzero amplitudes
`a : ℕ → ℂ` infinitely often, and a homogeneous degree-`D` polynomial `P : MvPolynomial (Fin (r+1)) ℂ`,
if `homogPolarize D P` vanishes on the unique-sum `D`-tuples of
`v m j = a m * (lam m : ℂ)^j`, then `P = 0` identically. -/
theorem reciprocal_accumulation_polarization_obstruction
    (r D : ℕ) {lam : ℕ → ℝ} {a : ℕ → ℂ}
    (h_inj : Function.Injective lam) (h_ne : ∀ n, lam n ≠ 0)
    (h_lim : Tendsto lam atTop (nhds 0))
    (h_inf : ∀ N : ℕ, ∃ m ≥ N, a m ≠ 0)
    {P : MvPolynomial (Fin (r + 1)) ℂ} (hP : P.IsHomogeneous D)
    (hvanish : ∀ p : Fin D → ℕ, IsUniqueSumPrefix lam D p →
      homogPolarize D P (fun i j => a (p i) * (lam (p i) : ℂ) ^ (j : ℕ)) = 0) :
    P = 0 := by
  have hlamC_inj : Function.Injective (fun m => (lam m : ℂ)) :=
    Complex.ofReal_injective.comp h_inj
  exact homogPoly_eq_zero_of_cofinite_tree_vanish
    (uniqueSumTree h_inj h_ne h_lim D)
    (fun m j => a m * (lam m : ℂ) ^ (j : ℕ))
    (vandermonde_tail_span_complex r hlamC_inj h_inf)
    hP hvanish

end PolarizationAndVandermonde

/-! ### 3. Paper #12 Affine Jet Ideal Linearization Core -/

section JetIdealLinearization

/-- Total degree of a finite sum of multivariate polynomials is bounded by the supremum of
their total degrees. -/
private lemma totalDegree_finset_sum_le {K : Type*} [CommRing K] {σ α : Type*}
    (s : Finset α) (f : α → MvPolynomial σ K) :
    (∑ a ∈ s, f a).totalDegree ≤ s.sup fun a => (f a).totalDegree := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sup_insert]
    exact le_trans (MvPolynomial.totalDegree_add _ _) (max_le_max le_rfl ih)

/-- Every partial derivative of a multivariate polynomial drops total degree strictly when
`R.totalDegree ≥ 1`. -/
lemma totalDegree_pderiv_lt {K : Type*} [CommRing K] {σ : Type*}
    (b : σ) {R : MvPolynomial σ K} (hpos : 0 < R.totalDegree) :
    (MvPolynomial.pderiv b R).totalDegree < R.totalDegree := by
  rw [MvPolynomial.totalDegree]
  refine (Finset.sup_lt_iff hpos).mpr fun d hd => ?_
  have hne : (MvPolynomial.pderiv b R).coeff d ≠ 0 := MvPolynomial.mem_support_iff.mp hd
  rw [MvPolynomial.coeff_pderiv] at hne
  have hR_ne : R.coeff (d + Finsupp.single b 1) ≠ 0 := fun h0 => by simp [h0] at hne
  have hmem : d + Finsupp.single b 1 ∈ R.support := MvPolynomial.mem_support_iff.mpr hR_ne
  have hle : (d + Finsupp.single b 1).sum (fun _ k => k) ≤ R.totalDegree :=
    Finset.le_sup (f := fun s : σ →₀ ℕ => s.sum fun _ k => k) hmem
  have hsum : (d + Finsupp.single b 1).sum (fun _ k => k) = d.sum (fun _ k => k) + 1 := by
    rw [Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl),
        Finsupp.sum_single_index rfl]
  omega

/-- Over a characteristic-zero integral domain, a multivariate polynomial whose partial
derivatives all vanish is constant. -/
lemma mvPoly_eq_C_of_forall_pderiv_eq_zero {K : Type*} [CommRing K] [IsDomain K] [CharZero K]
    {σ : Type*} {R : MvPolynomial σ K}
    (hp : ∀ b : σ, MvPolynomial.pderiv b R = 0) :
    R = MvPolynomial.C (R.coeff 0) := by
  ext d
  by_cases hd : d = 0
  · subst hd; simp [MvPolynomial.coeff_C]
  · rw [MvPolynomial.coeff_C, ite_eq_right_iff.mpr fun h => absurd h.symm hd]
    have hex : ∃ b : σ, d b ≠ 0 := by
      by_contra hall
      push Not at hall
      exact hd (Finsupp.ext hall)
    obtain ⟨b, hb⟩ := hex
    let d' : σ →₀ ℕ := d - Finsupp.single b 1
    have hd_eq : d' + Finsupp.single b 1 = d := by
      ext j
      simp only [d', Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply]
      by_cases hjb : b = j
      · subst hjb; simp only [ite_true]; omega
      · simp [hjb]
    have hcoeff0 : (MvPolynomial.pderiv b R).coeff d' = 0 := by rw [hp b]; simp
    rw [MvPolynomial.coeff_pderiv, hd_eq] at hcoeff0
    have hdb_eq : (d' b + 1 : ℕ) = d b := by
      have := congrArg (fun f : σ →₀ ℕ => f b) hd_eq
      simpa using this
    have hcast_ne : ((d' b : K) + 1) ≠ 0 := by
      have : ((d' b : K) + 1) = ((d b : ℕ) : K) := by rw [← hdb_eq]; push_cast; rfl
      rw [this]
      exact Nat.cast_ne_zero.mpr hb
    exact (mul_eq_zero.mp hcoeff0).resolve_right hcast_ne

/-- First-order Taylor extraction combined with minimal total degree discharges the directional
gradient vanishing hypothesis identically in `MvPolynomial (Fin r) K`. -/
theorem taylor_dominance_of_eval_grad_zero
    {K A : Type*} [Field K] [CharZero K] [CommRing A] [IsDomain A] [Algebra K A]
    {N r : ℕ} {ι : Type*}
    (y : Fin N → A) (M : ι → Fin N → K) (c : Fin r → Fin N)
    (htaylor : ∀ (R : MvPolynomial (Fin r) K),
      MvPolynomial.aeval (y ∘ c) R = 0 →
      ∀ i : ι,
        MvPolynomial.aeval (y ∘ c)
          (∑ b : Fin r, MvPolynomial.C (M i (c b)) * MvPolynomial.pderiv b R) = 0)
    (R : MvPolynomial (Fin r) K) (hR_ne : R ≠ 0)
    (hR_zero : MvPolynomial.aeval (y ∘ c) R = 0)
    (hR_min : ∀ Q : MvPolynomial (Fin r) K, Q ≠ 0 →
      MvPolynomial.aeval (y ∘ c) Q = 0 → R.totalDegree ≤ Q.totalDegree)
    (i : ι) :
    ∑ b : Fin r, MvPolynomial.C (M i (c b)) * MvPolynomial.pderiv b R = 0 := by
  let G : MvPolynomial (Fin r) K :=
    ∑ b : Fin r, MvPolynomial.C (M i (c b)) * MvPolynomial.pderiv b R
  by_contra hG_ne
  have hG_eval : MvPolynomial.aeval (y ∘ c) G = 0 := htaylor R hR_zero i
  have hR_pos : 0 < R.totalDegree := by
    by_contra h0
    have hdeg0 : R.totalDegree = 0 := Nat.eq_zero_of_not_pos h0
    have hconst : R = MvPolynomial.C (R.coeff 0) :=
      MvPolynomial.totalDegree_eq_zero_iff_eq_C.mp hdeg0
    have hval : algebraMap K A (R.coeff 0) = 0 := by
      rw [hconst, MvPolynomial.aeval_C] at hR_zero
      exact hR_zero
    have hc0 : R.coeff 0 = 0 :=
      (map_eq_zero_iff (algebraMap K A) (RingHom.injective _)).mp hval
    exact hR_ne (by rw [hconst, hc0, map_zero])
  have hG_lt : G.totalDegree < R.totalDegree := by
    have hle : G.totalDegree ≤ Finset.univ.sup fun b : Fin r =>
        (MvPolynomial.C (M i (c b)) * MvPolynomial.pderiv b R).totalDegree :=
      totalDegree_finset_sum_le Finset.univ _
    refine lt_of_le_of_lt hle ?_
    refine (Finset.sup_lt_iff hR_pos).mpr fun b _ => ?_
    calc (MvPolynomial.C (M i (c b)) * MvPolynomial.pderiv b R).totalDegree
        ≤ (MvPolynomial.C (M i (c b))).totalDegree + (MvPolynomial.pderiv b R).totalDegree :=
          MvPolynomial.totalDegree_mul _ _
      _ = (MvPolynomial.pderiv b R).totalDegree := by simp
      _ < R.totalDegree := totalDegree_pderiv_lt b hR_pos
  exact not_lt_of_ge (hR_min G hG_ne hG_eval) hG_lt

/-- **Paper #12 Target 1A — Pure Algebraic Pivot-Minimality Engine:**
Over any characteristic-zero field `K` and domain `K`-algebra `A`, if a minimal-total-degree
annihilator of `y ∘ c` has its gradient annihilated by an invertible `r × r` minor of `M`, then
`y ∘ c` is algebraically independent over `K`. -/
theorem pivot_algebraicIndependent_of_grad_annihilated
    {K A : Type*} [Field K] [CharZero K] [CommRing A] [IsDomain A] [Algebra K A]
    {N r : ℕ} {ι : Type*}
    (y : Fin N → A) (M : ι → Fin N → K)
    (c : Fin r → Fin N) (rows : Fin r → ι)
    (hdet : (Matrix.of fun a b => M (rows a) (c b)).det ≠ 0)
    (hgrad : ∀ (R : MvPolynomial (Fin r) K),
      R ≠ 0 →
      MvPolynomial.aeval (y ∘ c) R = 0 →
      (∀ Q : MvPolynomial (Fin r) K, Q ≠ 0 → MvPolynomial.aeval (y ∘ c) Q = 0 →
        R.totalDegree ≤ Q.totalDegree) →
      ∀ a : Fin r,
        ∑ b : Fin r, MvPolynomial.C (M (rows a) (c b)) * MvPolynomial.pderiv b R = 0) :
    AlgebraicIndependent K (y ∘ c) := by
  rw [algebraicIndependent_iff]
  intro P hP
  by_contra hP_ne
  have hex : ∃ d : ℕ, ∃ R : MvPolynomial (Fin r) K,
      R ≠ 0 ∧ MvPolynomial.aeval (y ∘ c) R = 0 ∧ R.totalDegree = d :=
    ⟨P.totalDegree, P, hP_ne, hP, rfl⟩
  obtain ⟨R, hR_ne, hR_zero, hR_deg⟩ := Nat.find_spec hex
  have hR_min : ∀ Q : MvPolynomial (Fin r) K, Q ≠ 0 →
      MvPolynomial.aeval (y ∘ c) Q = 0 → R.totalDegree ≤ Q.totalDegree := fun Q hQ_ne hQ_zero => by
    rw [hR_deg]
    exact Nat.find_min' hex ⟨Q, hQ_ne, hQ_zero, rfl⟩
  let B : Matrix (Fin r) (Fin r) K := Matrix.of fun a b => M (rows a) (c b)
  have hunit : IsUnit B.det := isUnit_iff_ne_zero.mpr hdet
  have hBinv : B⁻¹ * B = 1 := Matrix.nonsing_inv_mul B hunit
  have hall_pderiv : ∀ b₀ : Fin r, MvPolynomial.pderiv b₀ R = 0 := by
    intro b₀
    have hlin : ∑ a : Fin r, MvPolynomial.C (B⁻¹ b₀ a) *
        (∑ b : Fin r, MvPolynomial.C (B a b) * MvPolynomial.pderiv b R) = 0 := by
      refine Finset.sum_eq_zero fun a _ => ?_
      have ha : ∑ b : Fin r, MvPolynomial.C (B a b) * MvPolynomial.pderiv b R = 0 :=
        hgrad R hR_ne hR_zero hR_min a
      rw [ha, mul_zero]
    have hrearr :
        ∑ a : Fin r, MvPolynomial.C (B⁻¹ b₀ a) *
          (∑ b : Fin r, MvPolynomial.C (B a b) * MvPolynomial.pderiv b R) =
        ∑ b : Fin r, MvPolynomial.C ((B⁻¹ * B) b₀ b) * MvPolynomial.pderiv b R := by
      simp_rw [Finset.mul_sum, ← mul_assoc, ← map_mul]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [← Finset.sum_mul, ← map_sum]
      rfl
    rw [hrearr, hBinv] at hlin
    have hsingle : ∑ b : Fin r, MvPolynomial.C ((1 : Matrix (Fin r) (Fin r) K) b₀ b) *
        MvPolynomial.pderiv b R = MvPolynomial.pderiv b₀ R := by
      rw [Finset.sum_eq_single b₀]
      · simp
      · intro b _ hne; simp [Matrix.one_apply_ne (Ne.symm hne)]
      · intro h; exact absurd (Finset.mem_univ b₀) h
    rw [hsingle] at hlin
    exact hlin
  have hconst : R = MvPolynomial.C (R.coeff 0) :=
    mvPoly_eq_C_of_forall_pderiv_eq_zero hall_pderiv
  have hval : algebraMap K A (R.coeff 0) = 0 := by
    rw [hconst, MvPolynomial.aeval_C] at hR_zero
    exact hR_zero
  have hc0 : R.coeff 0 = 0 :=
    (map_eq_zero_iff (algebraMap K A) (RingHom.injective _)).mp hval
  exact hR_ne (by rw [hconst, hc0, map_zero])

/-- Linear map associated to a split Stokes jump matrix `M : ι → Fin N → K`. -/
def jumpLinearMap {K : Type*} [CommRing K] {ι : Type*} {N : ℕ}
    (M : ι → Fin N → K) : (Fin N → K) →ₗ[K] (ι → K) where
  toFun v i := ∑ k : Fin N, M i k * v k
  map_add' u v := by
    funext i
    simp [mul_add, Finset.sum_add_distrib]
  map_smul' a v := by
    funext i
    simp [Finset.mul_sum, mul_left_comm]

/-- Given a linear map `jumpLinearMap M : (Fin N → K) →ₗ[K] (ι → K)` of rank `r` over a field `K`,
there exist `r` pivot columns `c : Fin r → Fin N`, `N - r` complementary non-pivot columns
`cBar : Fin (N - r) → Fin N`, and `r` pivot rows `rows : Fin r → ι` such that the `r × r` minor
`(M (rows a) (c b))` is nonsingular. -/
theorem exists_pivots_and_nonpivots {K : Type*} [Field K] {ι : Type*} {N : ℕ}
    (M : ι → Fin N → K) :
    let r := Module.finrank K (LinearMap.range (jumpLinearMap M))
    ∃ (c : Fin r → Fin N) (cBar : Fin (N - r) → Fin N) (rows : Fin r → ι),
      Function.Injective c ∧
      Function.Injective cBar ∧
      Disjoint (Set.range c) (Set.range cBar) ∧
      Set.range c ∪ Set.range cBar = Set.univ ∧
      (Matrix.of fun a b => M (rows a) (c b)).det ≠ 0 := by
  intro r
  let L := jumpLinearMap M
  let col : Fin N → (ι → K) := fun k => L (Pi.single k 1)
  have hcol_val : ∀ k i, col k i = M i k := fun k i => by
    simp [col, L, jumpLinearMap, Pi.single_apply]
  have hspan_cols : Submodule.span K (Set.range col) = LinearMap.range L := by
    apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨k, rfl⟩
      exact ⟨Pi.single k 1, rfl⟩
    · rintro _ ⟨v, rfl⟩
      have hv : v = ∑ k : Fin N, v k • Pi.single k (1 : K) := by
        funext j; simp [Pi.single_apply]
      rw [hv, map_sum]
      refine Submodule.sum_mem _ fun k _ => ?_
      rw [map_smul]
      exact Submodule.smul_mem _ (v k) (Submodule.subset_span ⟨k, rfl⟩)
  -- Build a maximal linearly independent Finset S ⊆ Fin N of column indices
  have hex_S : ∃ S : Finset (Fin N),
      LinearIndependent K (fun k : S => col k) ∧
      Submodule.span K (col '' (S : Set (Fin N))) = LinearMap.range L := by
    let good : Finset (Finset (Fin N)) :=
      Finset.univ.filter fun T => LinearIndependent K (fun k : T => col k)
    have hne : good.Nonempty :=
      ⟨∅, Finset.mem_filter.mpr ⟨Finset.mem_univ _, linearIndependent_empty_type⟩⟩
    obtain ⟨S, hS_mem, hS_max⟩ := Finset.exists_max_image good Finset.card hne
    have hS_ind : LinearIndependent K (fun k : S => col k) := (Finset.mem_filter.mp hS_mem).2
    refine ⟨S, hS_ind, ?_⟩
    apply le_antisymm
    · rw [Submodule.span_le]
      rintro _ ⟨k, _, rfl⟩
      exact ⟨Pi.single k 1, rfl⟩
    · rw [← hspan_cols, Submodule.span_le]
      rintro _ ⟨k, rfl⟩
      by_cases hk : k ∈ S
      · exact Submodule.subset_span ⟨k, hk, rfl⟩
      · by_contra hnotmem
        let embS : S ↪ {x // x ∈ insert k S} :=
          ⟨fun j => ⟨j.1, Finset.mem_insert_of_mem j.2⟩,
           fun a b h => Subtype.ext (by simpa using congrArg Subtype.val h)⟩
        have hequiv : (Finset.univ : Finset {x // x ∈ insert k S}) =
            insert ⟨k, Finset.mem_insert_self k S⟩ ((Finset.univ : Finset S).map embS) := by
          ext ⟨x, hx⟩
          simp only [Finset.mem_univ, Finset.mem_insert, Finset.mem_map, embS, true_iff]
          rcases Finset.mem_insert.mp hx with rfl | hxS
          · exact Or.inl rfl
          · exact Or.inr ⟨⟨x, hxS⟩, trivial, rfl⟩
        have hnot : (⟨k, Finset.mem_insert_self k S⟩ : {x // x ∈ insert k S}) ∉
            (Finset.univ : Finset S).map embS := by
          simp only [Finset.mem_map, Finset.mem_univ, true_and, embS, not_exists]
          intro j hj
          have hval : j.1 = k := congrArg Subtype.val hj
          exact hk (hval ▸ j.2)
        have hS'_ind : LinearIndependent K (fun j : (insert k S : Finset (Fin N)) => col j) := by
          rw [Fintype.linearIndependent_iff]
          intro g hsum
          have htot : g ⟨k, Finset.mem_insert_self k S⟩ • col k +
              ∑ j : S, g (embS j) • col j.1 = 0 := by
            rw [← hsum, hequiv, Finset.sum_insert hnot, Finset.sum_map]
            rfl
          have hgk : g ⟨k, Finset.mem_insert_self k S⟩ = 0 := by
            by_contra hgne
            have hcol_mem : col k ∈ Submodule.span K (col '' (S : Set (Fin N))) := by
              have h1 := eq_neg_of_add_eq_zero_left htot
              have h2 := congrArg ((g ⟨k, Finset.mem_insert_self k S⟩)⁻¹ • ·) h1
              simp only [inv_smul_smul₀ hgne] at h2
              rw [h2]
              refine Submodule.smul_mem _ _ (Submodule.neg_mem _ (Submodule.sum_mem _ fun j _ => ?_))
              exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨j.1, j.2, rfl⟩)
            exact hnotmem hcol_mem
          intro j
          by_cases hjk : j.1 = k
          · have : j = ⟨k, Finset.mem_insert_self k S⟩ := Subtype.ext hjk
            rw [this, hgk]
          · have hjS : j.1 ∈ S := (Finset.mem_insert.mp j.2).resolve_left hjk
            have hrest : ∑ x : S, g (embS x) • col x.1 = 0 := by
              simpa [hgk] using htot
            exact Fintype.linearIndependent_iff.mp hS_ind (fun x : S => g (embS x)) hrest ⟨j.1, hjS⟩
        have hmem_ins : insert k S ∈ good := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hS'_ind⟩
        have hle := hS_max (insert k S) hmem_ins
        rw [Finset.card_insert_of_notMem hk] at hle
        omega
  obtain ⟨S, hS_ind, hS_span⟩ := hex_S
  -- Show S.card = r
  have hS_card : S.card = r := by
    have hbasis : Module.Basis S K (LinearMap.range L) :=
      Module.Basis.mk (v := fun k : S => ⟨col k.1, ⟨Pi.single k.1 1, rfl⟩⟩)
        (hS_ind.of_comp (LinearMap.range L).subtype)
        (by
          intro ⟨y, hy⟩ _
          have hy' := hy
          rw [← hS_span] at hy'
          have hmap : Submodule.map (LinearMap.range L).subtype
              (Submodule.span K (Set.range fun k : S =>
                (⟨col k.1, ⟨Pi.single k.1 1, rfl⟩⟩ : LinearMap.range L))) =
              Submodule.span K (col '' (S : Set (Fin N))) := by
            rw [Submodule.map_span]
            congr 1
            ext z
            simp only [Set.mem_image, Set.mem_range, Submodule.coe_subtype]
            constructor
            · rintro ⟨_, ⟨⟨k, hk⟩, rfl⟩, rfl⟩
              exact ⟨k, hk, rfl⟩
            · rintro ⟨k, hk, rfl⟩
              exact ⟨⟨col k, ⟨Pi.single k 1, rfl⟩⟩, ⟨⟨k, hk⟩, rfl⟩, rfl⟩
          rw [← hmap] at hy'
          obtain ⟨z, hz, hzy⟩ := hy'
          have : z = ⟨y, hy⟩ := Subtype.ext hzy
          exact this ▸ hz)
    have hfr := Module.finrank_eq_card_basis hbasis
    simpa [r] using hfr.symm
  -- Enumerate S and Sᶜ via equivalences with Fin r and Fin (N - r)
  have hSc_card : Fintype.card (Sᶜ : Finset (Fin N)) = N - r := by
    rw [Fintype.card_coe, Finset.card_compl, Fintype.card_fin, hS_card]
  let eS : Fin r ≃ S := (Fintype.equivFinOfCardEq (by rw [Fintype.card_coe, hS_card])).symm
  let eSc : Fin (N - r) ≃ (Sᶜ : Finset (Fin N)) := (Fintype.equivFinOfCardEq hSc_card).symm
  let c : Fin r → Fin N := fun b => (eS b).1
  let cBar : Fin (N - r) → Fin N := fun j => (eSc j).1
  have hc_inj : Function.Injective c := fun a b h => eS.injective (Subtype.ext h)
  have hcBar_inj : Function.Injective cBar := fun a b h => eSc.injective (Subtype.ext h)
  have hdisj : Disjoint (Set.range c) (Set.range cBar) := by
    rw [Set.disjoint_left]
    rintro _ ⟨b, rfl⟩ ⟨j, hj⟩
    have hbS : c b ∈ S := (eS b).2
    have hjSc : cBar j ∈ Sᶜ := (eSc j).2
    rw [hj] at hjSc
    exact Finset.mem_compl.mp hjSc hbS
  have hunion : Set.range c ∪ Set.range cBar = Set.univ := by
    ext k
    simp only [Set.mem_union, Set.mem_range, Set.mem_univ, iff_true]
    by_cases hk : k ∈ S
    · exact Or.inl ⟨eS.symm ⟨k, hk⟩, by simp [c]⟩
    · exact Or.inr ⟨eSc.symm ⟨k, Finset.mem_compl.mpr hk⟩, by simp [cBar]⟩
  -- Rows of (M i (c b)) span Fin r → K
  have hcol_c_ind : LinearIndependent K (fun b : Fin r => col (c b)) :=
    hS_ind.comp eS eS.injective
  let rowVec : ι → (Fin r → K) := fun i b => M i (c b)
  have hrow_span : Submodule.span K (Set.range rowVec) = ⊤ := by
    by_contra hne
    let U := Submodule.span K (Set.range rowVec)
    have hlt : Module.finrank K U < Module.finrank K (Fin r → K) := by
      rw [← finrank_top K (Fin r → K)]
      exact Submodule.finrank_lt_finrank_of_lt (lt_top_iff_ne_top.mpr hne)
    let ev : (Fin r → K) →ₗ[K] (U →ₗ[K] K) :=
      { toFun := fun v =>
          { toFun := fun u => ∑ b : Fin r, u.1 b * v b
            map_add' := fun u₁ u₂ => by simp [add_mul, Finset.sum_add_distrib]
            map_smul' := fun a u => by simp [Finset.mul_sum, mul_assoc] }
        map_add' := fun v₁ v₂ => by ext u; simp [mul_add, Finset.sum_add_distrib]
        map_smul' := fun a v => by ext u; simp [Finset.mul_sum, mul_left_comm] }
    have hker_pos : 0 < Module.finrank K (LinearMap.ker ev) := by
      have h1 := LinearMap.finrank_range_add_finrank_ker ev
      have h2 : Module.finrank K (LinearMap.range ev) ≤ Module.finrank K (U →ₗ[K] K) :=
        Submodule.finrank_le _
      have h3 : Module.finrank K (U →ₗ[K] K) = Module.finrank K U :=
        Module.finrank_linearMap_self K K U
      omega
    have : Nontrivial (LinearMap.ker ev) := Module.nontrivial_of_finrank_pos hker_pos
    obtain ⟨⟨v, hv_ker⟩, hv_ne⟩ := exists_ne (0 : LinearMap.ker ev)
    have hv_ne0 : v ≠ 0 := fun h0 => hv_ne (Subtype.ext h0)
    have hlin_dep : ∑ b : Fin r, v b • col (c b) = 0 := by
      funext i
      simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply, hcol_val]
      have hrow_mem : rowVec i ∈ U := Submodule.subset_span ⟨i, rfl⟩
      have h0 : ∑ b : Fin r, rowVec i b * v b = 0 := by
        have := congrArg (fun f : U →ₗ[K] K => f ⟨rowVec i, hrow_mem⟩) hv_ker
        simpa [ev] using this
      simpa [rowVec, mul_comm] using h0
    exact hv_ne0 (funext (Fintype.linearIndependent_iff.mp hcol_c_ind v hlin_dep))
  -- Pick r linearly independent rows by induction on k ≤ r
  have hex_k : ∀ k ≤ r, ∃ f : Fin k → ι, LinearIndependent K (fun a : Fin k => rowVec (f a)) := by
    intro k
    induction k with
    | zero => intro _; exact ⟨Fin.elim0, linearIndependent_empty_type⟩
    | succ k ih =>
      intro hk
      obtain ⟨f, hf_ind⟩ := ih (Nat.le_of_succ_le hk)
      have hlt : Module.finrank K (Submodule.span K (Set.range fun a : Fin k => rowVec (f a))) <
          Module.finrank K (Fin r → K) := by
        rw [finrank_span_eq_card hf_ind, Fintype.card_fin, Module.finrank_fin_fun]
        exact hk
      have hne_top : Submodule.span K (Set.range fun a : Fin k => rowVec (f a)) ≠ ⊤ := by
        intro htop
        rw [htop, finrank_top] at hlt
        exact lt_irrefl _ hlt
      have hex_i : ∃ i : ι, rowVec i ∉ Submodule.span K (Set.range fun a : Fin k => rowVec (f a)) := by
        by_contra hall
        push Not at hall
        have hsub : Submodule.span K (Set.range rowVec) ≤
            Submodule.span K (Set.range fun a : Fin k => rowVec (f a)) := by
          rw [Submodule.span_le]
          rintro _ ⟨i, rfl⟩
          exact hall i
        rw [hrow_span, top_le_iff] at hsub
        exact hne_top hsub
      obtain ⟨i₀, hi₀⟩ := hex_i
      refine ⟨Fin.snoc f i₀, ?_⟩
      rw [Fintype.linearIndependent_iff]
      intro g hsum
      have hglast : g (Fin.last k) = 0 := by
        by_contra hgne
        have hmem : rowVec i₀ ∈ Submodule.span K (Set.range fun a : Fin k => rowVec (f a)) := by
          rw [Fin.sum_univ_castSucc] at hsum
          simp only [Fin.snoc_castSucc, Fin.snoc_last] at hsum
          have h1 : g (Fin.last k) • rowVec i₀ = -(∑ a : Fin k, g a.castSucc • rowVec (f a)) :=
            eq_neg_of_add_eq_zero_right hsum
          have h2 := congrArg ((g (Fin.last k))⁻¹ • ·) h1
          simp only [inv_smul_smul₀ hgne] at h2
          rw [h2]
          exact Submodule.smul_mem _ _ (Submodule.neg_mem _ (Submodule.sum_mem _ fun a _ =>
            Submodule.smul_mem _ _ (Submodule.subset_span ⟨a, rfl⟩)))
        exact hi₀ hmem
      intro a
      refine Fin.lastCases hglast (fun a' => ?_) a
      rw [Fin.sum_univ_castSucc] at hsum
      simp only [Fin.snoc_castSucc, Fin.snoc_last, hglast, zero_smul, add_zero] at hsum
      exact Fintype.linearIndependent_iff.mp hf_ind (fun x => g x.castSucc) hsum a'
  obtain ⟨rows, hrows_ind⟩ := hex_k r le_rfl
  refine ⟨c, cBar, rows, hc_inj, hcBar_inj, hdisj, hunion, ?_⟩
  let B : Matrix (Fin r) (Fin r) K := Matrix.of fun a b => M (rows a) (c b)
  intro hdet0
  obtain ⟨v, hv_ne, hv_mul⟩ := Matrix.exists_vecMul_eq_zero_iff.mpr hdet0
  have hlin : ∑ a : Fin r, v a • rowVec (rows a) = 0 := by
    funext b
    have hb := congrFun hv_mul b
    simpa [Matrix.vecMul, dotProduct, B, rowVec, Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hb
  exact hv_ne (funext (Fintype.linearIndependent_iff.mp hrows_ind v hlin))

/-- For any basis `kerBasis` of `LinearMap.ker (jumpLinearMap M)` and any pivot/non-pivot
partition `(c, cBar, rows)` with nonsingular `r × r` minor, the `(N - r) × (N - r)` non-pivot
restriction matrix `fun ℓ j => kerBasis ℓ (cBar j)` is invertible. -/
theorem nonPivotSubmatrix_det_ne_zero {K : Type*} [Field K] {ι : Type*} {N r : ℕ}
    (M : ι → Fin N → K)
    (c : Fin r → Fin N) (cBar : Fin (N - r) → Fin N) (rows : Fin r → ι)
    (hunion : Set.range c ∪ Set.range cBar = Set.univ)
    (hdet : (Matrix.of fun a b => M (rows a) (c b)).det ≠ 0)
    (kerBasis : Fin (N - r) → Fin N → K)
    (hker_mem : ∀ ℓ, kerBasis ℓ ∈ LinearMap.ker (jumpLinearMap M))
    (hker_ind : LinearIndependent K kerBasis) :
    (Matrix.of fun (ℓ j : Fin (N - r)) => kerBasis ℓ (cBar j)).det ≠ 0 := by
  let Q : Matrix (Fin (N - r)) (Fin (N - r)) K := Matrix.of fun ℓ j => kerBasis ℓ (cBar j)
  intro hQ0
  obtain ⟨α, hα_ne, hα_mul⟩ := Matrix.exists_vecMul_eq_zero_iff.mpr hQ0
  let v : Fin N → K := ∑ ℓ : Fin (N - r), α ℓ • kerBasis ℓ
  have hv_ker : v ∈ LinearMap.ker (jumpLinearMap M) :=
    Submodule.sum_mem _ fun ℓ _ => Submodule.smul_mem _ _ (hker_mem ℓ)
  have hv_cBar : ∀ j : Fin (N - r), v (cBar j) = 0 := fun j => by
    have hj := congrFun hα_mul j
    simpa [v, Matrix.vecMul, dotProduct, Q, Finset.sum_apply, Pi.smul_apply, smul_eq_mul] using hj
  let B : Matrix (Fin r) (Fin r) K := Matrix.of fun a b => M (rows a) (c b)
  have hB_vc : B *ᵥ (v ∘ c) = 0 := by
    funext a
    have ha : ∑ k : Fin N, M (rows a) k * v k = 0 := congrFun hv_ker (rows a)
    have hsplit : ∑ k : Fin N, M (rows a) k * v k = ∑ b : Fin r, M (rows a) (c b) * v (c b) := by
      have hc_inj : Function.Injective c := by
        intro b₁ b₂ hEq
        by_contra hne
        have hcol_eq : ∀ a', B a' b₁ = B a' b₂ := fun a' => by simp [B, hEq]
        exact hdet (Matrix.det_zero_of_column_eq hne hcol_eq)
      rw [← Finset.sum_image (f := fun k => M (rows a) k * v k) (s := Finset.univ)
        (g := c) (fun x _ y _ h => hc_inj h)]
      refine (Finset.sum_subset (Finset.subset_univ _) ?_).symm
      intro k _ hk_not
      have hk_in : k ∈ Set.range c ∪ Set.range cBar := hunion.symm ▸ Set.mem_univ k
      rcases hk_in with ⟨b, rfl⟩ | ⟨j, rfl⟩
      · exact absurd (Finset.mem_image.mpr ⟨b, Finset.mem_univ b, rfl⟩) hk_not
      · simp [hv_cBar j]
    rw [hsplit] at ha
    simpa [Matrix.mulVec, dotProduct, B] using ha
  have hvc_zero : v ∘ c = 0 := Matrix.eq_zero_of_mulVec_eq_zero hdet hB_vc
  have hv_zero : v = 0 := by
    funext k
    have hk_in : k ∈ Set.range c ∪ Set.range cBar := hunion.symm ▸ Set.mem_univ k
    rcases hk_in with ⟨b, rfl⟩ | ⟨j, rfl⟩
    · exact congrFun hvc_zero b
    · exact hv_cBar j
  exact hα_ne (funext (Fintype.linearIndependent_iff.mp hker_ind α hv_zero))

/-- **Paper #12 Target 1B — Exact Affine Linear Ideal Linearization Theorem:**
Given algebraically independent pivot coordinates `y ∘ c` and `N - r` affine linear relations
whose non-pivot submatrix is invertible, the entire polynomial vanishing ideal
`RingHom.ker (MvPolynomial.aeval y)` is generated by those `N - r` affine linear polynomials,
`Algebra.adjoin K (Set.range y) = Algebra.adjoin K (Set.range (y ∘ c))`, and its exact
transcendence degree is `r`. -/
theorem ideal_eq_affine_linear_of_kernel_and_pivots
    {K A : Type*} [Field K] [CommRing A] [IsDomain A] [Algebra K A]
    {N r : ℕ} (y : Fin N → A)
    (c : Fin r → Fin N) (cBar : Fin (N - r) → Fin N)
    (hc_inj : Function.Injective c) (hcBar_inj : Function.Injective cBar)
    (hdisj : Disjoint (Set.range c) (Set.range cBar))
    (hunion : Set.range c ∪ Set.range cBar = Set.univ)
    (hindep : AlgebraicIndependent K (y ∘ c))
    (kerBasis : Fin (N - r) → Fin N → K) (hvals : Fin (N - r) → K)
    (hlin : ∀ ℓ : Fin (N - r),
      ∑ k : Fin N, algebraMap K A (kerBasis ℓ k) * y k = algebraMap K A (hvals ℓ))
    (hnonpiv : (Matrix.of fun (ℓ j : Fin (N - r)) => kerBasis ℓ (cBar j)).det ≠ 0) :
    RingHom.ker (MvPolynomial.aeval y) =
      Ideal.span (Set.range fun ℓ : Fin (N - r) =>
        (∑ k : Fin N, MvPolynomial.C (kerBasis ℓ k) * MvPolynomial.X k) -
          MvPolynomial.C (hvals ℓ)) ∧
    Algebra.adjoin K (Set.range y) = Algebra.adjoin K (Set.range (y ∘ c)) ∧
    Algebra.trdeg K (Algebra.adjoin K (Set.range y)) = (r : Cardinal) := by
  let L : Fin (N - r) → MvPolynomial (Fin N) K := fun ℓ =>
    (∑ k : Fin N, MvPolynomial.C (kerBasis ℓ k) * MvPolynomial.X k) - MvPolynomial.C (hvals ℓ)
  let I : Ideal (MvPolynomial (Fin N) K) := Ideal.span (Set.range L)
  let Q : Matrix (Fin (N - r)) (Fin (N - r)) K := Matrix.of fun ℓ j => kerBasis ℓ (cBar j)
  have hQ_unit : IsUnit Q.det := isUnit_iff_ne_zero.mpr hnonpiv
  let w : Fin (N - r) → Fin N → K := fun j k => ∑ ℓ : Fin (N - r), Q⁻¹ j ℓ * kerBasis ℓ k
  let d : Fin (N - r) → K := fun j => ∑ ℓ : Fin (N - r), Q⁻¹ j ℓ * hvals ℓ
  have hw_cBar : ∀ j j' : Fin (N - r), w j (cBar j') = if j = j' then 1 else 0 := fun j j' => by
    have hmul : (Q⁻¹ * Q) j j' = (1 : Matrix (Fin (N - r)) (Fin (N - r)) K) j j' := by
      rw [Matrix.nonsing_inv_mul Q hQ_unit]
    simpa [w, Q, Matrix.mul_apply, Matrix.one_apply] using hmul
  let W : Fin (N - r) → MvPolynomial (Fin N) K := fun j =>
    MvPolynomial.X (cBar j) +
      (∑ b : Fin r, MvPolynomial.C (w j (c b)) * MvPolynomial.X (c b)) - MvPolynomial.C (d j)
  have hW_eq : ∀ j : Fin (N - r), W j = ∑ ℓ : Fin (N - r), MvPolynomial.C (Q⁻¹ j ℓ) * L ℓ := by
    intro j
    have hsum_L : ∑ ℓ : Fin (N - r), MvPolynomial.C (Q⁻¹ j ℓ) * L ℓ =
        (∑ k : Fin N, MvPolynomial.C (w j k) * MvPolynomial.X k) - MvPolynomial.C (d j) := by
      simp only [L, mul_sub, Finset.sum_sub_distrib, Finset.mul_sum, ← mul_assoc, ← map_mul]
      congr 1
      · rw [Finset.sum_comm]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [← Finset.sum_mul, ← map_sum]
      · rw [← map_sum]
    rw [hsum_L]
    have hdisj_fs : Disjoint (Finset.univ.image c) (Finset.univ.image cBar) := by
      rw [Finset.disjoint_left]
      intro k hk1 hk2
      rw [Finset.mem_image] at hk1 hk2
      obtain ⟨b, _, rfl⟩ := hk1
      obtain ⟨j', _, hj'⟩ := hk2
      exact Set.disjoint_left.mp hdisj ⟨b, rfl⟩ ⟨j', hj'⟩
    have hunion_fs : Finset.univ.image c ∪ Finset.univ.image cBar = Finset.univ := by
      ext k
      simp only [Finset.mem_union, Finset.mem_image, Finset.mem_univ, true_and, iff_true]
      have hk : k ∈ Set.range c ∪ Set.range cBar := hunion.symm ▸ Set.mem_univ k
      simpa [Set.mem_range] using hk
    have hsplit : ∑ k : Fin N, MvPolynomial.C (w j k) * MvPolynomial.X k =
        (∑ b : Fin r, MvPolynomial.C (w j (c b)) * MvPolynomial.X (c b)) +
        (∑ j' : Fin (N - r), MvPolynomial.C (w j (cBar j')) * MvPolynomial.X (cBar j')) := by
      rw [← hunion_fs, Finset.sum_union hdisj_fs,
          Finset.sum_image (fun a _ b _ h => hc_inj h),
          Finset.sum_image (fun a _ b _ h => hcBar_inj h)]
    have hcBar_term :
        ∑ j' : Fin (N - r), MvPolynomial.C (w j (cBar j')) * MvPolynomial.X (cBar j') =
        MvPolynomial.X (cBar j) := by
      rw [Finset.sum_eq_single j]
      · rw [hw_cBar j j, ite_eq_left_iff.mpr fun h => absurd rfl h, map_one, one_mul]
      · intro j' _ hne
        rw [hw_cBar j j', ite_eq_right_iff.mpr fun h => absurd h.symm hne, map_zero, zero_mul]
      · intro h; exact absurd (Finset.mem_univ j) h
    rw [hsplit, hcBar_term, add_comm]
  have hW_mem_I : ∀ j : Fin (N - r), W j ∈ I := fun j => by
    rw [hW_eq j]
    exact Ideal.sum_mem I fun ℓ _ =>
      Ideal.mul_mem_left I _ (Ideal.subset_span ⟨ℓ, rfl⟩)
  have hI_le_ker : I ≤ RingHom.ker (MvPolynomial.aeval y) := by
    rw [Ideal.span_le]
    rintro _ ⟨ℓ, rfl⟩
    change MvPolynomial.aeval y (L ℓ) = 0
    simp only [L, map_sub, map_sum, map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
    rw [hlin ℓ, sub_self]
  let elimImg : Fin N → MvPolynomial (Fin r) K := fun k =>
    if hk : k ∈ Set.range c then
      MvPolynomial.X (Classical.choose hk)
    else
      let hkBar : k ∈ Set.range cBar := (hunion.symm ▸ Set.mem_univ k).resolve_left hk
      let j := Classical.choose hkBar
      MvPolynomial.C (d j) - ∑ b : Fin r, MvPolynomial.C (w j (c b)) * MvPolynomial.X b
  have helim_c : ∀ b : Fin r, elimImg (c b) = MvPolynomial.X b := fun b => by
    have hk : c b ∈ Set.range c := ⟨b, rfl⟩
    simp only [elimImg]
    split_ifs
    congr 1
    exact hc_inj (Classical.choose_spec hk)
  have helim_cBar : ∀ j : Fin (N - r),
      elimImg (cBar j) =
        MvPolynomial.C (d j) - ∑ b : Fin r, MvPolynomial.C (w j (c b)) * MvPolynomial.X b := fun j => by
    have hnot : cBar j ∉ Set.range c := fun h => Set.disjoint_left.mp hdisj h ⟨j, rfl⟩
    simp only [elimImg]
    split_ifs
    have hkBar : cBar j ∈ Set.range cBar := (hunion.symm ▸ Set.mem_univ (cBar j)).resolve_left hnot
    have hchoose : Classical.choose hkBar = j := hcBar_inj (Classical.choose_spec hkBar)
    simp [hchoose]
  let π : MvPolynomial (Fin N) K →ₐ[K] MvPolynomial (Fin r) K := MvPolynomial.aeval elimImg
  let emb : MvPolynomial (Fin r) K →ₐ[K] MvPolynomial (Fin N) K := MvPolynomial.rename c
  have hquot_eq :
      (Ideal.Quotient.mkₐ K I).comp (emb.comp π) = Ideal.Quotient.mkₐ K I := by
    apply MvPolynomial.algHom_ext
    intro k
    simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk]
    rw [Ideal.Quotient.eq]
    have hk_in : k ∈ Set.range c ∪ Set.range cBar := hunion.symm ▸ Set.mem_univ k
    rcases hk_in with ⟨b, rfl⟩ | ⟨j, rfl⟩
    · simp [π, emb, helim_c b, sub_self, I.zero_mem]
    · simp only [π, emb, MvPolynomial.aeval_X, helim_cBar j, map_sub, map_sum, map_mul,
        MvPolynomial.rename_C, MvPolynomial.rename_X]
      have hneg :
          (MvPolynomial.C (d j) -
            ∑ b : Fin r, MvPolynomial.C (w j (c b)) * MvPolynomial.X (c b)) -
            MvPolynomial.X (cBar j) = -W j := by
        simp only [W]; ring
      rw [hneg]
      exact I.neg_mem (hW_mem_I j)
  have hker_eq : RingHom.ker (MvPolynomial.aeval y) = I := by
    apply le_antisymm _ hI_le_ker
    intro P hP
    have hsub_mem : emb (π P) - P ∈ I := by
      have hq := AlgHom.congr_fun hquot_eq P
      simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at hq
      exact Ideal.Quotient.eq.mp hq
    have hsub_eval : MvPolynomial.aeval y (emb (π P) - P) = 0 := hI_le_ker hsub_mem
    have hemb_eval : MvPolynomial.aeval y (emb (π P)) = MvPolynomial.aeval (y ∘ c) (π P) := by
      simp [emb, MvPolynomial.aeval_rename]
    have hpi_eval : MvPolynomial.aeval (y ∘ c) (π P) = 0 := by
      rw [map_sub, hemb_eval] at hsub_eval
      have hP0 : MvPolynomial.aeval y P = 0 := hP
      rw [hP0, sub_zero] at hsub_eval
      exact hsub_eval
    have hpi_zero : π P = 0 := (algebraicIndependent_iff.mp hindep) (π P) hpi_eval
    rw [hpi_zero, map_zero, zero_sub] at hsub_mem
    simpa using I.neg_mem hsub_mem
  have hadjoin_eq : Algebra.adjoin K (Set.range y) = Algebra.adjoin K (Set.range (y ∘ c)) := by
    apply le_antisymm
    · rw [Algebra.adjoin_le_iff]
      rintro _ ⟨k, rfl⟩
      have hk_in : k ∈ Set.range c ∪ Set.range cBar := hunion.symm ▸ Set.mem_univ k
      rcases hk_in with ⟨b, rfl⟩ | ⟨j, rfl⟩
      · exact Algebra.subset_adjoin ⟨b, rfl⟩
      · have hWj0 : MvPolynomial.aeval y (W j) = 0 := hI_le_ker (hW_mem_I j)
        simp only [W, map_sub, map_add, map_sum, map_mul, MvPolynomial.aeval_X,
          MvPolynomial.aeval_C] at hWj0
        have hy_eq : y (cBar j) = algebraMap K A (d j) -
            ∑ b : Fin r, algebraMap K A (w j (c b)) * y (c b) := by
          linear_combination hWj0
        rw [hy_eq]
        refine Subalgebra.sub_mem _ (Subalgebra.algebraMap_mem _ _)
          (Subalgebra.sum_mem _ fun b _ => Subalgebra.mul_mem _
            (Subalgebra.algebraMap_mem _ _) (Algebra.subset_adjoin ⟨b, rfl⟩))
    · refine Algebra.adjoin_mono ?_
      rintro _ ⟨b, rfl⟩
      exact ⟨c b, rfl⟩
  have htrdeg : Algebra.trdeg K (Algebra.adjoin K (Set.range y)) = (r : Cardinal) := by
    rw [hadjoin_eq]
    let e : MvPolynomial (Fin r) K ≃ₐ[K] Algebra.adjoin K (Set.range (y ∘ c)) :=
      AlgEquiv.ofBijective
        (AlgHom.codRestrict (MvPolynomial.aeval (y ∘ c))
          (Algebra.adjoin K (Set.range (y ∘ c))) fun P => by
            rw [Algebra.adjoin_range_eq_range_aeval]
            exact ⟨P, rfl⟩)
        ⟨fun P₁ P₂ h => hindep (congrArg Subtype.val h),
         fun ⟨a, ha⟩ => by
            rw [Algebra.adjoin_range_eq_range_aeval] at ha
            obtain ⟨P, hP⟩ := ha
            exact ⟨P, Subtype.ext hP⟩⟩
    have htr := e.lift_trdeg_eq
    rw [MvPolynomial.trdeg_of_isDomain, Cardinal.mk_fintype, Fintype.card_fin] at htr
    simpa [Cardinal.lift_natCast] using htr.symm
  exact ⟨hker_eq, hadjoin_eq, htrdeg⟩

/-- Abstract Stokes-jump system over a characteristic-zero field `K` and domain `K`-algebra `A`:
packages the jet coordinates `y : Fin N → A`, the split Stokes jump matrix `M : ι → Fin N → K`
(linear evaluation map `Δ = jumpLinearMap M`), first-order Taylor dominance, and kernel-to-base
gluing. -/
structure StokesJetSystem (K A : Type*) [Field K] [CharZero K] [CommRing A] [IsDomain A]
    [Algebra K A] (ι : Type*) (N : ℕ) where
  /-- Formal jet coordinates `y : Fin N → A`. -/
  y : Fin N → A
  /-- Split Stokes jump matrix `M : ι → Fin N → K`. -/
  M : ι → Fin N → K
  /-- First-order Taylor dominance: every minimal-total-degree polynomial relation on `r` columns
  has its gradient annihilated by every row of `M`. -/
  taylor_dominance : ∀ {r : ℕ} (c : Fin r → Fin N) (R : MvPolynomial (Fin r) K),
    R ≠ 0 →
    MvPolynomial.aeval (y ∘ c) R = 0 →
    (∀ Q : MvPolynomial (Fin r) K, Q ≠ 0 → MvPolynomial.aeval (y ∘ c) Q = 0 →
      R.totalDegree ≤ Q.totalDegree) →
    ∀ i : ι, ∑ b : Fin r, MvPolynomial.C (M i (c b)) * MvPolynomial.pderiv b R = 0
  /-- Kernel-to-base gluing: every vector in `ker (jumpLinearMap M)` contracts `y` into `K`. -/
  kernel_to_base : ∀ v ∈ LinearMap.ker (jumpLinearMap M),
    ∃ h : K, ∑ k : Fin N, algebraMap K A (v k) * y k = algebraMap K A h

/-- **Paper #12 Master Theorem II — Affine Jet Ideal Linearization Theorem:**
For any `StokesJetSystem K A ι N` with split rank `r = Module.finrank K (LinearMap.range (jumpLinearMap S.M))`:
1. There exists an `r`-element pivot column basis `c : Fin r → Fin N` with `AlgebraicIndependent K (S.y ∘ c)`.
2. For ANY `K`-basis `B_ker : Module.Basis (Fin (N - r)) K (LinearMap.ker (jumpLinearMap S.M))`,
   the unique base values `hvals ℓ : K` satisfy
   `RingHom.ker (MvPolynomial.aeval S.y) = Ideal.span (affine linear generators from B_ker)`.
3. `Algebra.adjoin K (Set.range S.y) = Algebra.adjoin K (Set.range (S.y ∘ c))` and
   `Algebra.trdeg K (Algebra.adjoin K (Set.range S.y)) = (r : Cardinal)`. -/
theorem stokes_jet_ideal_linearization
    {K A : Type*} [Field K] [CharZero K] [CommRing A] [IsDomain A] [Algebra K A]
    {ι : Type*} {N : ℕ} (S : StokesJetSystem K A ι N) :
    let r := Module.finrank K (LinearMap.range (jumpLinearMap S.M))
    (∃ c : Fin r → Fin N,
      Function.Injective c ∧
      AlgebraicIndependent K (S.y ∘ c) ∧
      Algebra.adjoin K (Set.range S.y) = Algebra.adjoin K (Set.range (S.y ∘ c))) ∧
    (∀ (B_ker : Module.Basis (Fin (N - r)) K (LinearMap.ker (jumpLinearMap S.M))),
      ∃ hvals : Fin (N - r) → K,
        (∀ ℓ, ∑ k : Fin N, algebraMap K A ((B_ker ℓ).1 k) * S.y k = algebraMap K A (hvals ℓ)) ∧
        RingHom.ker (MvPolynomial.aeval S.y) =
          Ideal.span (Set.range fun ℓ : Fin (N - r) =>
            (∑ k : Fin N, MvPolynomial.C ((B_ker ℓ).1 k) * MvPolynomial.X k) -
              MvPolynomial.C (hvals ℓ))) ∧
    Algebra.trdeg K (Algebra.adjoin K (Set.range S.y)) = (r : Cardinal) := by
  intro r
  obtain ⟨c, cBar, rows, hc_inj, hcBar_inj, hdisj, hunion, hdet⟩ :=
    exists_pivots_and_nonpivots S.M
  have hindep : AlgebraicIndependent K (S.y ∘ c) :=
    pivot_algebraicIndependent_of_grad_annihilated S.y S.M c rows hdet
      (fun R hR_ne hR_zero hR_min a => S.taylor_dominance c R hR_ne hR_zero hR_min (rows a))
  have hker_dim : Module.finrank K (LinearMap.ker (jumpLinearMap S.M)) = N - r := by
    have hrn := LinearMap.finrank_range_add_finrank_ker (jumpLinearMap S.M)
    rw [Module.finrank_fin_fun] at hrn
    omega
  have hbasis_proof : ∀ (B_ker : Module.Basis (Fin (N - r)) K (LinearMap.ker (jumpLinearMap S.M))),
      ∃ hvals : Fin (N - r) → K,
        (∀ ℓ, ∑ k : Fin N, algebraMap K A ((B_ker ℓ).1 k) * S.y k = algebraMap K A (hvals ℓ)) ∧
        RingHom.ker (MvPolynomial.aeval S.y) =
          Ideal.span (Set.range fun ℓ : Fin (N - r) =>
            (∑ k : Fin N, MvPolynomial.C ((B_ker ℓ).1 k) * MvPolynomial.X k) -
              MvPolynomial.C (hvals ℓ)) ∧
        Algebra.adjoin K (Set.range S.y) = Algebra.adjoin K (Set.range (S.y ∘ c)) ∧
        Algebra.trdeg K (Algebra.adjoin K (Set.range S.y)) = (r : Cardinal) := by
    intro B_ker
    have hex_h : ∀ ℓ : Fin (N - r),
        ∃ h : K, ∑ k : Fin N, algebraMap K A ((B_ker ℓ).1 k) * S.y k = algebraMap K A h :=
      fun ℓ => S.kernel_to_base (B_ker ℓ).1 (B_ker ℓ).2
    choose hvals hhvals using hex_h
    have hker_ind : LinearIndependent K (fun ℓ => (B_ker ℓ).1) :=
      B_ker.linearIndependent.map' (LinearMap.ker (jumpLinearMap S.M)).subtype
        (Submodule.ker_subtype _)
    have hnonpiv : (Matrix.of fun (ℓ j : Fin (N - r)) => (B_ker ℓ).1 (cBar j)).det ≠ 0 :=
      nonPivotSubmatrix_det_ne_zero S.M c cBar rows hunion hdet
        (fun ℓ => (B_ker ℓ).1) (fun ℓ => (B_ker ℓ).2) hker_ind
    obtain ⟨hker, hadj, htr⟩ := ideal_eq_affine_linear_of_kernel_and_pivots
      S.y c cBar hc_inj hcBar_inj hdisj hunion hindep
      (fun ℓ => (B_ker ℓ).1) hvals hhvals hnonpiv
    exact ⟨hvals, hhvals, hker, hadj, htr⟩
  let B0 : Module.Basis (Fin (N - r)) K (LinearMap.ker (jumpLinearMap S.M)) :=
    Module.finBasisOfFinrankEq K (LinearMap.ker (jumpLinearMap S.M)) hker_dim
  obtain ⟨_, _, _, hadj0, htr0⟩ := hbasis_proof B0
  refine ⟨⟨c, hc_inj, hindep, hadj0⟩, ?_, htr0⟩
  intro B_ker
  obtain ⟨hvals, hhvals, hker, _, _⟩ := hbasis_proof B_ker
  exact ⟨hvals, hhvals, hker⟩

/-- Field-level specialization: when `A = L` is a field extension of `K`, the intermediate field
`IntermediateField.adjoin K (Set.range S.y)` also has exact transcendence degree equal to the
split rank `r`. -/
theorem stokes_jet_ideal_linearization_field
    {K L : Type*} [Field K] [CharZero K] [Field L] [Algebra K L]
    {ι : Type*} {N : ℕ} (S : StokesJetSystem K L ι N) :
    let r := Module.finrank K (LinearMap.range (jumpLinearMap S.M))
    Algebra.trdeg K (IntermediateField.adjoin K (Set.range S.y)) = (r : Cardinal) := by
  intro r
  obtain ⟨⟨c, _, hindep, hadj⟩, _, _⟩ := stokes_jet_ideal_linearization S
  let F := IntermediateField.adjoin K (Set.range S.y)
  have hc_mem : ∀ b : Fin r, S.y (c b) ∈ F := fun b =>
    IntermediateField.subset_adjoin K (Set.range S.y) ⟨c b, rfl⟩
  let ycF : Fin r → F := fun b => ⟨S.y (c b), hc_mem b⟩
  have hindep_F : AlgebraicIndependent K ycF := hindep.of_comp F.val
  have hle : (r : Cardinal) ≤ Algebra.trdeg K F := by
    have h1 := hindep_F.lift_cardinalMk_le_trdeg
    rw [Cardinal.mk_fintype, Fintype.card_fin] at h1
    simpa using h1
  have hF_eq : F = IntermediateField.adjoin K (Set.range (S.y ∘ c)) := by
    apply le_antisymm
    · rw [IntermediateField.adjoin_le_iff]
      rintro x hx
      have hx' : x ∈ Algebra.adjoin K (Set.range (S.y ∘ c)) := hadj ▸ Algebra.subset_adjoin hx
      exact Algebra.adjoin_le_iff.mpr (IntermediateField.subset_adjoin K (Set.range (S.y ∘ c))) hx'
    · refine IntermediateField.adjoin.mono K _ _ ?_
      rintro _ ⟨b, rfl⟩
      exact ⟨c b, rfl⟩
  have htr_le : Algebra.trdeg K F ≤ (r : Cardinal) := by
    have : Algebra.IsAlgebraic (Algebra.adjoin K (Set.range ycF)) F := by
      refine ⟨fun ⟨x, hx⟩ => ?_⟩
      rw [hF_eq, IntermediateField.mem_adjoin_iff_div] at hx
      obtain ⟨p, hp, q, hq, hx_eq⟩ := hx
      have hmem_lift : ∀ z ∈ Algebra.adjoin K (Set.range (S.y ∘ c)),
          ∃ hz : z ∈ F, (⟨z, hz⟩ : F) ∈ Algebra.adjoin K (Set.range ycF) := by
        intro z hz
        refine Algebra.adjoin_induction
          (fun w hw => ?_) (fun k => ⟨Subalgebra.algebraMap_mem _ k, Subalgebra.algebraMap_mem _ k⟩)
          (fun _ _ _ _ ⟨h1, h1'⟩ ⟨h2, h2'⟩ => ⟨add_mem h1 h2, Subalgebra.add_mem _ h1' h2'⟩)
          (fun _ _ _ _ ⟨h1, h1'⟩ ⟨h2, h2'⟩ => ⟨mul_mem h1 h2, Subalgebra.mul_mem _ h1' h2'⟩) hz
        obtain ⟨b, rfl⟩ := hw
        exact ⟨hc_mem b, Algebra.subset_adjoin ⟨b, rfl⟩⟩
      obtain ⟨hpF, hpA⟩ := hmem_lift p hp
      obtain ⟨hqF, hqA⟩ := hmem_lift q hq
      by_cases hq0 : q = 0
      · subst hq0
        simp only [div_zero] at hx_eq
        subst hx_eq
        exact isAlgebraic_zero
      · let pA : Algebra.adjoin K (Set.range ycF) := ⟨⟨p, hpF⟩, hpA⟩
        let qA : Algebra.adjoin K (Set.range ycF) := ⟨⟨q, hqF⟩, hqA⟩
        refine ⟨Polynomial.C qA * Polynomial.X - Polynomial.C pA, ?_, ?_⟩
        · intro h0
          have hc1 := congrArg (fun f : Polynomial _ => f.coeff 1) h0
          simp only [Polynomial.coeff_sub, Polynomial.coeff_C_mul_X, Polynomial.coeff_C,
            ite_eq_right_iff.mpr (fun h => absurd h one_ne_zero), sub_zero,
            Polynomial.coeff_zero] at hc1
          exact hq0 (congrArg (fun z : Algebra.adjoin K (Set.range ycF) => z.1.1) hc1)
        · simp only [Polynomial.aeval_sub, Polynomial.aeval_mul, Polynomial.aeval_C,
            Polynomial.aeval_X]
          apply Subtype.ext
          change q * x - p = 0
          rw [hx_eq, mul_div_cancel₀ _ hq0, sub_self]
    have hcard_le := Algebra.IsAlgebraic.trdeg_le_cardinalMk (R := K) (A := F) (s := Set.range ycF)
    calc Algebra.trdeg K F ≤ Cardinal.mk (Set.range ycF) := hcard_le
      _ ≤ Cardinal.lift (Cardinal.mk (Fin r)) := by
          simpa using (Cardinal.mk_range_le_lift (f := ycF))
      _ = (r : Cardinal) := by simp
  exact le_antisymm htr_le hle

end JetIdealLinearization

/-! ### 4. Single-Singularity Arbitrary-Order-`d` Family (Example 6.3) -/

section SingleSingularityOrderD

/-- Distinct fractional exponents `β_j = (j + 1) / (d + 1) ∈ (0, 1) ∩ ℚ` for `j : Fin d`. -/
def singleSingBeta (d : ℕ) (j : Fin d) : ℚ :=
  ((j.val + 1 : ℕ) : ℚ) / ((d + 1 : ℕ) : ℚ)

theorem singleSingBeta_pos (d : ℕ) (j : Fin d) : 0 < singleSingBeta d j := by
  unfold singleSingBeta
  positivity

theorem singleSingBeta_lt_one (d : ℕ) (j : Fin d) : singleSingBeta d j < 1 := by
  unfold singleSingBeta
  rw [div_lt_one (by positivity : (0 : ℚ) < ((d + 1 : ℕ) : ℚ))]
  exact_mod_cast Nat.succ_lt_succ j.isLt

theorem singleSingBeta_strictMono (d : ℕ) : StrictMono (singleSingBeta d) := by
  intro i j hij
  unfold singleSingBeta
  rw [div_lt_div_iff_of_pos_right (by positivity : (0 : ℚ) < ((d + 1 : ℕ) : ℚ))]
  exact_mod_cast Nat.succ_lt_succ hij

/-- The `d` fractional exponents `β_j = (j + 1)/(d + 1)` belong to `d` pairwise distinct
residue classes modulo `ℤ`. -/
theorem singleSingBeta_distinct_mod_int (d : ℕ) {i j : Fin d} {n : ℤ}
    (h : singleSingBeta d i - singleSingBeta d j = n) : i = j := by
  have hi0 := singleSingBeta_pos d i
  have hi1 := singleSingBeta_lt_one d i
  have hj0 := singleSingBeta_pos d j
  have hj1 := singleSingBeta_lt_one d j
  have hlt1 : (n : ℚ) < 1 := by linarith
  have hgt_neg1 : (-1 : ℚ) < (n : ℚ) := by linarith
  have hn_lt : n < 1 := by exact_mod_cast hlt1
  have hn_gt : -1 < n := by exact_mod_cast hgt_neg1
  have hn0 : n = 0 := by omega
  rw [hn0, Int.cast_zero, sub_eq_zero] at h
  exact (singleSingBeta_strictMono d).injective h

/-- The `d × d` Stokes jet matrix `((-β_j)^k)_{j, k : Fin d}` over `ℚ`. -/
def singleSingJetMatrix (d : ℕ) : Matrix (Fin d) (Fin d) ℚ :=
  Matrix.of fun j k => (-singleSingBeta d j) ^ (k : ℕ)

/-- The `d × d` Stokes jet matrix `((-β_j)^k)_{j, k : Fin d}` over any `CharZero` field `K`. -/
def singleSingJetMatrixCast (K : Type*) [Field K] (d : ℕ) : Matrix (Fin d) (Fin d) K :=
  Matrix.of fun j k => (-(singleSingBeta d j : K)) ^ (k : ℕ)

theorem singleSingJetMatrix_det_ne_zero (d : ℕ) :
    (singleSingJetMatrix d).det ≠ 0 := by
  have heq : singleSingJetMatrix d = Matrix.vandermonde (fun j => -singleSingBeta d j) := by
    ext j k; simp [singleSingJetMatrix, Matrix.vandermonde_apply]
  rw [heq]
  exact Matrix.det_vandermonde_ne_zero_iff.mpr fun i j hij =>
    (singleSingBeta_strictMono d).injective (neg_injective hij)

theorem singleSingJetMatrixCast_det_ne_zero (K : Type*) [Field K] [CharZero K] (d : ℕ) :
    (singleSingJetMatrixCast K d).det ≠ 0 := by
  have heq : singleSingJetMatrixCast K d =
      Matrix.vandermonde (fun j => -(singleSingBeta d j : K)) := by
    ext j k; simp [singleSingJetMatrixCast, Matrix.vandermonde_apply]
  rw [heq]
  exact Matrix.det_vandermonde_ne_zero_iff.mpr fun i j hij =>
    (singleSingBeta_strictMono d).injective
      (Rat.cast_injective (neg_injective hij))

private lemma matrix_rank_eq_of_det_ne_zero {K : Type*} [Field K] {d : ℕ}
    (M : Matrix (Fin d) (Fin d) K) (hdet : M.det ≠ 0) : M.rank = d := by
  have hsurj : Function.Surjective M.mulVecLin := fun w =>
    ⟨M⁻¹ *ᵥ w, by
      change M *ᵥ (M⁻¹ *ᵥ w) = w
      rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv M (isUnit_iff_ne_zero.mpr hdet),
          Matrix.one_mulVec]⟩
  rw [Matrix.rank, LinearMap.range_eq_top.mpr hsurj, finrank_top, Module.finrank_fin_fun]

/-- Exact rank `d` of `singleSingJetMatrix d` over `ℚ` (and `singleSingJetMatrixCast K d` over
any `CharZero` field `K`). -/
theorem singleSingJetMatrix_rank (d : ℕ) : (singleSingJetMatrix d).rank = d :=
  matrix_rank_eq_of_det_ne_zero (singleSingJetMatrix d) (singleSingJetMatrix_det_ne_zero d)

theorem singleSingJetMatrixCast_rank (K : Type*) [Field K] [CharZero K] (d : ℕ) :
    (singleSingJetMatrixCast K d).rank = d :=
  matrix_rank_eq_of_det_ne_zero (singleSingJetMatrixCast K d)
    (singleSingJetMatrixCast_det_ne_zero K d)

/-- Formal Laurent-series linear operator `T = x ∂_x - 1/x` acting on coefficient sequences
`c : ℤ → K` by `(T c) n = n * c n - c (n + 1)`. -/
def singleSingLaurentT (K : Type*) [Field K] : Module.End K (ℤ → K) where
  toFun c n := (n : K) * c n - c (n + 1)
  map_add' c₁ c₂ := by funext n; simp [mul_add]; ring
  map_smul' a c := by funext n; simp [mul_left_comm, mul_sub]

/-- Shifted first-order operator `T + β` in `Module.End K (ℤ → K)`. -/
def singleSingLaurentTAdd (K : Type*) [Field K] (β : K) : Module.End K (ℤ → K) :=
  singleSingLaurentT K + β • (LinearMap.id : Module.End K (ℤ → K))

/-- Coefficient sequence of `x⁻¹` (supported at `n = -1`). -/
def laurentNegOne (K : Type*) [Field K] : ℤ → K :=
  fun n => if n = -1 then 1 else 0

/-- Rising factorial `(β)_n = β (β + 1) ⋯ (β + n - 1)`. -/
def singleSingRisingFac {K : Type*} [CommRing K] (β : K) : ℕ → K
  | 0 => 1
  | n + 1 => (β + (n : K)) * singleSingRisingFac β n

/-- Formal power series `f_β(x) = ∑_{n ≥ 0} (β)_n x^n` embedded in formal Laurent series `ℤ → K`. -/
def risingFacSeries {K : Type*} [CommRing K] (β : K) : ℤ → K :=
  fun n => if 0 ≤ n then singleSingRisingFac β n.toNat else 0

/-- Exact first-order inhomogeneous differential identity `(T + β) f_β = -x⁻¹` coefficientwise. -/
theorem laurentT_add_beta_risingFacSeries {K : Type*} [Field K] (β : K) :
    singleSingLaurentTAdd K β (risingFacSeries β) = -laurentNegOne K := by
  funext n
  change ((n : K) * risingFacSeries β n - risingFacSeries β (n + 1)) +
    β * risingFacSeries β n = -(if n = -1 then (1 : K) else 0)
  by_cases hn0 : 0 ≤ n
  · have hn1 : 0 ≤ n + 1 := by omega
    have hneg1 : n ≠ -1 := by omega
    rw [ite_eq_right_iff.mpr (fun h => absurd h hneg1), neg_zero]
    simp only [risingFacSeries, ite_eq_left_iff.mpr (fun h => absurd hn0 h),
      ite_eq_left_iff.mpr (fun h => absurd hn1 h)]
    have htoNat : (n + 1).toNat = n.toNat + 1 := by omega
    have hcast : ((n.toNat : ℕ) : K) = (n : K) := by
      rw [← Int.cast_natCast, Int.toNat_of_nonneg hn0]
    rw [htoNat, singleSingRisingFac, hcast]
    ring
  · by_cases hnm1 : n = -1
    · subst hnm1
      simp [risingFacSeries, singleSingRisingFac]
    · have hn1_not : ¬ (0 ≤ n + 1) := by omega
      simp [risingFacSeries, hn0, hn1_not, hnm1]

/-- Pure negative-power Laurent polynomials: sequences vanishing at all `n ≥ 0`. -/
def IsNegLaurentPoly {K : Type*} [Field K] (c : ℤ → K) : Prop :=
  ∀ n : ℤ, 0 ≤ n → c n = 0

lemma isNegLaurentPoly_neg_laurentNegOne (K : Type*) [Field K] :
    IsNegLaurentPoly (-laurentNegOne K) := fun n hn => by
  have hne : n ≠ -1 := by omega
  simp [laurentNegOne, hne]

lemma isNegLaurentPoly_laurentT {K : Type*} [Field K] {c : ℤ → K}
    (hc : IsNegLaurentPoly c) : IsNegLaurentPoly (singleSingLaurentT K c) := fun n hn => by
  have hn1 : 0 ≤ n + 1 := by omega
  simp [singleSingLaurentT, hc n hn, hc (n + 1) hn1]

lemma isNegLaurentPoly_add_beta {K : Type*} [Field K] (β : K) {c : ℤ → K}
    (hc : IsNegLaurentPoly c) :
    IsNegLaurentPoly (singleSingLaurentTAdd K β c) := fun n hn => by
  change ((n : K) * c n - c (n + 1)) + β * c n = 0
  have hn1 : 0 ≤ n + 1 := by omega
  simp [hc n hn, hc (n + 1) hn1]

lemma isNegLaurentPoly_add {K : Type*} [Field K] {c₁ c₂ : ℤ → K}
    (h1 : IsNegLaurentPoly c₁) (h2 : IsNegLaurentPoly c₂) :
    IsNegLaurentPoly (c₁ + c₂) := fun n hn => by
  simp [h1 n hn, h2 n hn]

lemma isNegLaurentPoly_smul {K : Type*} [Field K] (a : K) {c : ℤ → K}
    (hc : IsNegLaurentPoly c) : IsNegLaurentPoly (a • c) := fun n hn => by
  simp [hc n hn]

/-- For every `k : ℕ`, `T^k f_β - (-β)^k f_β` is a pure negative-power Laurent polynomial
(vanishing at all `n ≥ 0`), accounting for the exact `(-β)^k` jet multiplier. -/
theorem laurentT_pow_risingFacSeries_tail {K : Type*} [Field K] (β : K) :
    ∀ k : ℕ, IsNegLaurentPoly
      (((singleSingLaurentT K) ^ k) (risingFacSeries β) - (-β) ^ k • risingFacSeries β)
  | 0 => fun n _ => by simp
  | k + 1 => by
    have ih := laurentT_pow_risingFacSeries_tail β k
    have hstep :
        ((singleSingLaurentT K) ^ (k + 1)) (risingFacSeries β) - (-β) ^ (k + 1) • risingFacSeries β =
        singleSingLaurentT K
          (((singleSingLaurentT K) ^ k) (risingFacSeries β) - (-β) ^ k • risingFacSeries β) +
          (-β) ^ k • (singleSingLaurentTAdd K β (risingFacSeries β)) := by
      rw [pow_succ', mul_apply_eq_comp, map_sub, map_smul]
      ext n
      change ((singleSingLaurentT K) (((singleSingLaurentT K) ^ k) (risingFacSeries β))) n -
          (-β) ^ (k + 1) * risingFacSeries β n =
        (((singleSingLaurentT K) (((singleSingLaurentT K) ^ k) (risingFacSeries β))) n -
          (-β) ^ k * ((singleSingLaurentT K) (risingFacSeries β)) n) +
        (-β) ^ k * (((singleSingLaurentT K) (risingFacSeries β)) n + β * risingFacSeries β n)
      rw [pow_succ']
      ring
    rw [hstep, laurentT_add_beta_risingFacSeries]
    exact isNegLaurentPoly_add (isNegLaurentPoly_laurentT ih)
      (isNegLaurentPoly_smul _ (isNegLaurentPoly_neg_laurentNegOne K))

/-- Commutativity of `T + α` and `T + β` in `Module.End K (ℤ → K)`. -/
lemma laurentTAdd_commute {K : Type*} [Field K] (α β : K) :
    Commute (singleSingLaurentTAdd K α) (singleSingLaurentTAdd K β) := by
  unfold Commute SemiconjBy
  ext c n
  change ((n : K) * (((n : K) * c n - c (n + 1)) + β * c n) -
      (((n + 1 : ℤ) : K) * c (n + 1) - c (n + 1 + 1) + β * c (n + 1))) +
      α * (((n : K) * c n - c (n + 1)) + β * c n) =
    ((n : K) * (((n : K) * c n - c (n + 1)) + α * c n) -
      (((n + 1 : ℤ) : K) * c (n + 1) - c (n + 1 + 1) + α * c (n + 1))) +
      β * (((n : K) * c n - c (n + 1)) + α * c n)
  ring

/-- The explicit order-`d` polynomial operator `∏_{j : Fin d} (T + β_j)` on formal Laurent series,
constructed via `Polynomial.aeval (singleSingLaurentT K)` so the linear factors commute automatically. -/
def singleSingOrderDOp (K : Type*) [Field K] (d : ℕ) : Module.End K (ℤ → K) :=
  Polynomial.aeval (singleSingLaurentT K)
    (∏ j : Fin d, (Polynomial.X + Polynomial.C (singleSingBeta d j : K)))

/-- The formal sum `F_d = ∑_{j : Fin d} f_{β_j}` of the single-singularity order-`d` family. -/
def singleSingSumSeries (K : Type*) [Field K] (d : ℕ) : ℤ → K :=
  ∑ j : Fin d, risingFacSeries (singleSingBeta d j : K)

private lemma aeval_X_add_C_eq_laurentTAdd (K : Type*) [Field K] (β : K) :
    Polynomial.aeval (singleSingLaurentT K) (Polynomial.X + Polynomial.C β) =
      singleSingLaurentTAdd K β := by
  simp only [map_add, Polynomial.aeval_X, Polynomial.aeval_C, Algebra.algebraMap_eq_smul_one]
  rfl

private lemma isNegLaurentPoly_aeval_prod {K : Type*} [Field K] {d : ℕ} (S : Finset (Fin d))
    {c : ℤ → K} (hc : IsNegLaurentPoly c) :
    IsNegLaurentPoly
      ((Polynomial.aeval (singleSingLaurentT K)
        (∏ j ∈ S, (Polynomial.X + Polynomial.C (singleSingBeta d j : K)))) c) := by
  induction S using Finset.induction_on with
  | empty =>
    simpa using hc
  | @insert a S ha ih =>
    rw [Finset.prod_insert ha, map_mul, mul_apply_eq_comp, aeval_X_add_C_eq_laurentTAdd]
    exact isNegLaurentPoly_add_beta _ ih

/-- The explicit order-`d` linear operator `∏_{j : Fin d} (T + β_j)` maps every summand
`f_{β_j}` (and hence the total sum `F_d`) into pure negative-power Laurent polynomials. -/
theorem singleSingOrderDOp_annihilates_nonneg (K : Type*) [Field K] (d : ℕ) :
    IsNegLaurentPoly (singleSingOrderDOp K d (singleSingSumSeries K d)) := by
  unfold singleSingSumSeries
  rw [map_sum]
  have hterm : ∀ j : Fin d,
      IsNegLaurentPoly (singleSingOrderDOp K d (risingFacSeries (singleSingBeta d j : K))) := by
    intro j
    have hprod :
        (∏ i : Fin d, (Polynomial.X + Polynomial.C (singleSingBeta d i : K))) =
        (∏ i ∈ Finset.univ.erase j, (Polynomial.X + Polynomial.C (singleSingBeta d i : K))) *
          (Polynomial.X + Polynomial.C (singleSingBeta d j : K)) := by
      rw [mul_comm, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ j)]
    rw [singleSingOrderDOp, hprod, map_mul, mul_apply_eq_comp, aeval_X_add_C_eq_laurentTAdd,
        laurentT_add_beta_risingFacSeries]
    exact isNegLaurentPoly_aeval_prod (Finset.univ.erase j) (isNegLaurentPoly_neg_laurentNegOne K)
  intro n hn
  rw [Finset.sum_apply]
  exact Finset.sum_eq_zero fun j _ => hterm j n hn

/-- **Single-Singularity Arbitrary-Order-`d` Family Theorem (Example 6.3):**
For any `d ≥ 1` and characteristic-zero field `K`:
1. The `d` fractional exponents `β_j = (j + 1)/(d + 1)` lie in `(0, 1)` and are pairwise distinct
   modulo `ℤ`.
2. The `d × d` jet matrix `((-β_j)^k)_{j, k : Fin d}` has nonzero determinant and exact rank `d`.
3. Any `d`-jet vector `y : Fin d → A` obeying first-order Taylor dominance for this matrix is
   algebraically independent over `K`, ruling out all nonzero polynomial relations of order `< d`.
4. The explicit order-`d` operator `∏_j (T + β_j)` maps `F_d = ∑_j f_{β_j}` into pure
   negative-power Laurent polynomials (all `n ≥ 0` coefficients vanish). -/
theorem single_singularity_order_d_rank
    (K A : Type*) [Field K] [CharZero K] [CommRing A] [IsDomain A] [Algebra K A]
    (d : ℕ) (_hd : 1 ≤ d) :
    (∀ j : Fin d, 0 < singleSingBeta d j ∧ singleSingBeta d j < 1) ∧
    (∀ (i j : Fin d) (n : ℤ), singleSingBeta d i - singleSingBeta d j = n → i = j) ∧
    (singleSingJetMatrixCast K d).det ≠ 0 ∧
    (singleSingJetMatrixCast K d).rank = d ∧
    (∀ (y : Fin d → A),
      (∀ (R : MvPolynomial (Fin d) K), R ≠ 0 →
        MvPolynomial.aeval y R = 0 →
        (∀ Q : MvPolynomial (Fin d) K, Q ≠ 0 → MvPolynomial.aeval y Q = 0 →
          R.totalDegree ≤ Q.totalDegree) →
        ∀ j : Fin d,
          ∑ k : Fin d, MvPolynomial.C (singleSingJetMatrixCast K d j k) *
            MvPolynomial.pderiv k R = 0) →
      AlgebraicIndependent K y) ∧
    IsNegLaurentPoly (singleSingOrderDOp K d (singleSingSumSeries K d)) := by
  refine ⟨fun j => ⟨singleSingBeta_pos d j, singleSingBeta_lt_one d j⟩,
    fun i j n h => singleSingBeta_distinct_mod_int d h,
    singleSingJetMatrixCast_det_ne_zero K d,
    singleSingJetMatrixCast_rank K d,
    ?_,
    singleSingOrderDOp_annihilates_nonneg K d⟩
  intro y hgrad
  exact pivot_algebraicIndependent_of_grad_annihilated y (singleSingJetMatrixCast K d)
    id id (singleSingJetMatrixCast_det_ne_zero K d) hgrad

end SingleSingularityOrderD

end

end CubicTheta.AllD
