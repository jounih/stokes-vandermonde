/-! ### 1. Analyticity, Real-vs-Complex Derivatives, and Analytic Continuation on `ℂ \ {1}` -/

private lemma analyticOnNhd_iteratedDeriv {𝕜 F : Type*} [NontriviallyNormedField 𝕜]
    [NormedAddCommGroup F] [NormedSpace 𝕜 F] [CompleteSpace F]
    {f : 𝕜 → F} {U : Set 𝕜} (hf : AnalyticOnNhd 𝕜 f U) (k : ℕ) :
    AnalyticOnNhd 𝕜 (iteratedDeriv k f) U := by
  rw [iteratedDeriv_eq_iterate]
  exact hf.iterated_deriv k

private lemma iteratedDeriv_comp_affine_ofReal {f : ℂ → ℂ} {U : Set ℂ}
    (hU : IsOpen U) (hf : AnalyticOnNhd ℂ f U) (a b : ℂ) (k : ℕ) :
    ∀ x : ℝ, a + b * (x : ℂ) ∈ U →
      iteratedDeriv k (fun t : ℝ => f (a + b * (t : ℂ))) x =
        b ^ k * iteratedDeriv k f (a + b * (x : ℂ)) := by
  induction k with
  | zero =>
    intro x _
    simp
  | succ k ih =>
    intro x hx
    have hcont : Continuous fun t : ℝ => a + b * (t : ℂ) :=
      continuous_const.add (continuous_const.mul Complex.continuous_ofReal)
    have hev_mem : ∀ᶠ t : ℝ in 𝓝 x, a + b * (t : ℂ) ∈ U :=
      hcont.continuousAt.preimage_mem_nhds (hU.mem_nhds hx)
    have hev_eq : iteratedDeriv k (fun t : ℝ => f (a + b * (t : ℂ))) =ᶠ[𝓝 x]
        fun t : ℝ => b ^ k * iteratedDeriv k f (a + b * (t : ℂ)) := by
      filter_upwards [hev_mem] with t ht
      exact ih t ht
    rw [iteratedDeriv_succ, hev_eq.deriv_eq]
    have hfk : AnalyticOnNhd ℂ (iteratedDeriv k f) U := analyticOnNhd_iteratedDeriv hf k
    have hdiff_fk : HasDerivAt (iteratedDeriv k f) (deriv (iteratedDeriv k f) (a + b * (x : ℂ)))
        (a + b * (x : ℂ)) :=
      (hfk _ hx).differentiableAt.hasDerivAt
    have haff : HasDerivAt (fun t : ℝ => a + b * (t : ℂ)) b x := by
      simpa using ((hasDerivAt_id x).ofReal_comp.const_mul b).const_add a
    have hcomp : HasDerivAt (fun t : ℝ => b ^ k * iteratedDeriv k f (a + b * (t : ℂ)))
        (b ^ k * (b • deriv (iteratedDeriv k f) (a + b * (x : ℂ)))) x :=
      (hdiff_fk.scomp x haff).const_mul (b ^ k)
    rw [hcomp.deriv, iteratedDeriv_succ, smul_eq_mul]
    ring

private lemma iteratedDeriv_zeta_ofReal (k : ℕ) {x : ℝ} (hx : (x : ℂ) ≠ 1) :
    iteratedDeriv k (fun t : ℝ => riemannZeta (t : ℂ)) x = iteratedDeriv k riemannZeta (x : ℂ) := by
  have h := iteratedDeriv_comp_affine_ofReal isOpen_compl_singleton analyticOn_riemannZeta 0 1 k x
    (by simpa using hx)
  simpa using h

private lemma iteratedDeriv_zeta_one_sub_ofReal (k : ℕ) {x : ℝ} (hx : 1 - (x : ℂ) ≠ 1) :
    iteratedDeriv k (fun t : ℝ => riemannZeta (1 - (t : ℂ))) x =
      (-1 : ℂ) ^ k * iteratedDeriv k riemannZeta (1 - (x : ℂ)) := by
  have h := iteratedDeriv_comp_affine_ofReal isOpen_compl_singleton analyticOn_riemannZeta 1 (-1) k x
    (by simpa [sub_eq_add_neg] using hx)
  simpa [sub_eq_add_neg] using h

private lemma polynomial_analyticOnNhd (p : Polynomial ℂ) :
    AnalyticOnNhd ℂ (fun z : ℂ => p.eval z) Set.univ := by
  intro z _
  have heq : (fun w : ℂ => p.eval w) = fun w : ℂ => ∑ i ∈ p.support, p.coeff i * w ^ i := by
    ext w
    rw [Polynomial.eval_eq_sum]
    rfl
  rw [heq]
  have hsum : ∀ s : Finset ℕ, AnalyticAt ℂ (fun w : ℂ => ∑ i ∈ s, p.coeff i * w ^ i) z := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      simpa using analyticAt_const
    | @insert i s hi ih =>
      have hterm : AnalyticAt ℂ (fun w : ℂ => p.coeff i * w ^ i) z :=
        analyticAt_const.mul (analyticAt_id.pow i)
      have hadd : AnalyticAt ℂ (fun w : ℂ => p.coeff i * w ^ i + ∑ j ∈ s, p.coeff j * w ^ j) z :=
        hterm.add ih
      simpa [hi] using hadd
  exact hsum p.support

private lemma odeEval_analyticOnNhd {r : ℕ} (P : MvPolynomial (Fin (r + 1)) (Polynomial ℂ)) :
    AnalyticOnNhd ℂ
      (fun z : ℂ => MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val riemannZeta z)
        (evalU P z))
      ({1}ᶜ : Set ℂ) := by
  induction P using MvPolynomial.induction_on with
  | C p =>
    intro z _
    simpa [evalU] using polynomial_analyticOnNhd p z (Set.mem_univ z)
  | add A B hA hB =>
    intro z hz
    have hfun : (fun w : ℂ =>
        MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val riemannZeta w)
          (evalU (A + B) w)) =
        (fun w => MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val riemannZeta w)
          (evalU A w)) +
        (fun w => MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val riemannZeta w)
          (evalU B w)) := by
      ext w; simp [evalU, map_add]
    rw [hfun]
    exact (hA z hz).add (hB z hz)
  | mul_X A j hA =>
    intro z hz
    have hfun : (fun w : ℂ =>
        MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val riemannZeta w)
          (evalU (A * MvPolynomial.X j) w)) =
        (fun w => MvPolynomial.eval (fun k : Fin (r + 1) => iteratedDeriv k.val riemannZeta w)
          (evalU A w)) *
        (fun w => iteratedDeriv j.val riemannZeta w) := by
      ext w; simp [evalU, map_mul]
    rw [hfun]
    exact (hA z hz).mul (analyticOnNhd_iteratedDeriv analyticOn_riemannZeta j.val z hz)

private lemma zeta_ade_atTop_to_compl_one {r : ℕ}
    (P : MvPolynomial (Fin (r + 1)) (Polynomial ℂ))
    (hP : ∀ᶠ u : ℝ in Filter.atTop,
      MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val (fun x : ℝ => riemannZeta (x : ℂ)) u)
        (evalU P (u : ℂ)) = 0) :
    ∀ z : ℂ, z ≠ 1 →
      MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val riemannZeta z)
        (evalU P z) = 0 := by
  let F : ℂ → ℂ := fun z =>
    MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val riemannZeta z) (evalU P z)
  obtain ⟨R, hR⟩ := eventually_atTop.mp hP
  let x₀ : ℝ := max R 2
  have hx₀_ge_R : R ≤ x₀ := le_max_left _ _
  have hx₀_ge_2 : 2 ≤ x₀ := le_max_right _ _
  have hx₀_mem : (x₀ : ℂ) ∈ ({1}ᶜ : Set ℂ) := by
    intro h1
    have hr := congrArg Complex.re h1
    simp only [Complex.ofReal_re, Complex.one_re] at hr
    linarith
  have hfreq : ∃ᶠ z in 𝓝[≠] (x₀ : ℂ), F z = 0 := by
    rw [Filter.frequently_iff]
    intro s hs
    obtain ⟨ε, hε, hball⟩ := Metric.mem_nhdsWithin_iff.mp hs
    let t : ℝ := x₀ + ε / 2
    have ht_gt_x₀ : x₀ < t := by dsimp only [t]; linarith
    have ht_ge_R : R ≤ t := hx₀_ge_R.trans ht_gt_x₀.le
    have ht_ne_one : (t : ℂ) ≠ 1 := by
      intro h1
      have hr := congrArg Complex.re h1
      simp only [Complex.ofReal_re, Complex.one_re] at hr
      linarith
    have hdist : dist (t : ℂ) (x₀ : ℂ) < ε := by
      rw [Complex.dist_eq, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
      have : t - x₀ = ε / 2 := by simp [t]
      rw [this, abs_of_pos (half_pos hε)]
      linarith
    have hne : (t : ℂ) ≠ (x₀ : ℂ) := by
      intro h
      exact ht_gt_x₀.ne' (Complex.ofReal_injective h)
    refine ⟨(t : ℂ), hball ⟨hdist, hne⟩, ?_⟩
    have hreal := hR t ht_ge_R
    have heq : (fun j : Fin (r + 1) => iteratedDeriv j.val (fun x : ℝ => riemannZeta (x : ℂ)) t) =
        fun j : Fin (r + 1) => iteratedDeriv j.val riemannZeta (t : ℂ) :=
      funext fun j => iteratedDeriv_zeta_ofReal j.val ht_ne_one
    dsimp only [F]
    rw [← heq]
    exact hreal
  have hpre : IsPreconnected ({1}ᶜ : Set ℂ) :=
    (isConnected_compl_singleton_of_one_lt_rank (by simp) (1 : ℂ)).isPreconnected
  have hEqOn := (odeEval_analyticOnNhd P).eqOn_zero_of_preconnected_of_frequently_eq_zero
    hpre hx₀_mem hfreq
  intro z hz
  exact hEqOn hz

/-! ### 2. Polynomial / Rational Differential-Algebra Helpers -/

private noncomputable def polyToMvNat : Polynomial ℂ →+* MvPolynomial ℕ ℂ :=
  Polynomial.eval₂RingHom MvPolynomial.C (MvPolynomial.X 0)

private lemma eval_polyToMvNat (p : Polynomial ℂ) (y : ℕ → ℂ) :
    MvPolynomial.eval y (polyToMvNat p) = p.eval (y 0) := by
  have h : (MvPolynomial.eval y).comp polyToMvNat = Polynomial.evalRingHom (y 0) := by
    apply Polynomial.ringHom_ext
    · intro c; simp [polyToMvNat]
    · simp [polyToMvNat]
  exact RingHom.congr_fun h p

private noncomputable def mvPolyToMvNat {r : ℕ} :
    MvPolynomial (Fin (r + 1)) (Polynomial ℂ) →+* MvPolynomial ℕ ℂ :=
  MvPolynomial.eval₂Hom polyToMvNat (fun j : Fin (r + 1) => MvPolynomial.X (j.val + 1))

private lemma eval_mvPolyToMvNat {r : ℕ} (P : MvPolynomial (Fin (r + 1)) (Polynomial ℂ)) (y : ℕ → ℂ) :
    MvPolynomial.eval y (mvPolyToMvNat P) =
      MvPolynomial.eval (fun j : Fin (r + 1) => y (j.val + 1)) (evalU P (y 0)) := by
  have h : (MvPolynomial.eval y).comp (mvPolyToMvNat (r := r)) =
      (MvPolynomial.eval (fun j : Fin (r + 1) => y (j.val + 1))).comp
        (MvPolynomial.map (Polynomial.evalRingHom (y 0))) := by
    apply MvPolynomial.ringHom_ext
    · intro p
      simp [mvPolyToMvNat, eval_polyToMvNat]
    · intro j
      simp [mvPolyToMvNat]
  exact RingHom.congr_fun h P

private lemma eq_zero_of_eval_evalU_eq_zero {r : ℕ}
    {P : MvPolynomial (Fin (r + 1)) (Polynomial ℂ)}
    (h : ∀ (u : ℂ) (x : Fin (r + 1) → ℂ), MvPolynomial.eval x (evalU P u) = 0) :
    P = 0 := by
  rw [MvPolynomial.ext_iff]
  intro α
  rw [show (0 : MvPolynomial (Fin (r + 1)) (Polynomial ℂ)).coeff α = 0 from rfl]
  apply Polynomial.funext
  intro u
  rw [Polynomial.eval_zero]
  have hU0 : evalU P u = 0 := MvPolynomial.funext (h u)
  have hc := congrArg (fun Q : MvPolynomial (Fin (r + 1)) ℂ => Q.coeff α) hU0
  rw [evalU, MvPolynomial.coeff_map, Polynomial.coe_evalRingHom] at hc
  exact hc

private lemma mvPolyToMvNat_eq_zero_imp {r : ℕ}
    {P : MvPolynomial (Fin (r + 1)) (Polynomial ℂ)} (hP : mvPolyToMvNat P = 0) : P = 0 := by
  refine eq_zero_of_eval_evalU_eq_zero fun u x => ?_
  let y : ℕ → ℂ := fun n =>
    if n = 0 then u else x ⟨(n - 1) % (r + 1), Nat.mod_lt _ (Nat.succ_pos r)⟩
  have hy0 : y 0 = u := by simp [y]
  have hyj : ∀ j : Fin (r + 1), y (j.val + 1) = x j := by
    intro j
    simp [y, Nat.mod_eq_of_lt j.isLt]
  have h1 := eval_mvPolyToMvNat P y
  rw [hP, map_zero, hy0] at h1
  simpa [hyj] using h1.symm

private def jetVec (f : ℝ → ℂ) (n : ℕ) (i : Fin (n + 1)) (x : ℝ) : ℂ :=
  if i.val = 0 then (x : ℂ) else iteratedDeriv (i.val - 1) f x

private def topSep (f : ℝ → ℂ) (n : ℕ) (Q : MvPolynomial (Fin (n + 1)) ℂ) (x : ℝ) : ℂ :=
  MvPolynomial.eval (fun j => jetVec f n j x) (MvPolynomial.pderiv (Fin.last n) Q)

private lemma exists_ordinary_ode (U : Set ℝ) (hU_open : IsOpen U) (hU_ne : U.Nonempty)
    (f : ℝ → ℂ) {r : ℕ} (P : MvPolynomial (Fin (r + 1)) (Polynomial ℂ)) (hP_ne : P ≠ 0)
    (hP_vanish : ∀ x ∈ U,
      MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val f x) (evalU P (x : ℂ)) = 0) :
    ∃ (n : ℕ) (Q : MvPolynomial (Fin (n + 1)) ℂ) (x₀ : ℝ),
      0 < n ∧ x₀ ∈ U ∧ topSep f n Q x₀ ≠ 0 ∧
      ∀ z ∈ U, MvPolynomial.eval (fun j => jetVec f n j z) Q = 0 := by
  classical
  let y : ℕ → ℝ → ℂ := fun i x => if i = 0 then (x : ℂ) else iteratedDeriv (i - 1) f x
  have hmv_ne : mvPolyToMvNat P ≠ 0 := fun h0 => hP_ne (mvPolyToMvNat_eq_zero_imp h0)
  have hmv_vanish : ∀ x ∈ U, MvPolynomial.eval (fun i => y i x) (mvPolyToMvNat P) = 0 := by
    intro x hx
    rw [eval_mvPolyToMvNat]
    have hy0 : y 0 x = (x : ℂ) := by simp [y]
    have hyj : ∀ j : Fin (r + 1), y (j.val + 1) x = iteratedDeriv j.val f x := by
      intro j; simp [y]
    rw [hy0]
    simp_rw [hyj]
    exact hP_vanish x hx
  obtain ⟨n, Q, x₀, hx₀, hS_ne, hQ_vanish⟩ :=
    ordinary_relation U hU_ne y ⟨mvPolyToMvNat P, hmv_ne, hmv_vanish⟩
  have hn_ne : n ≠ 0 := by
    rintro rfl
    let q : Polynomial ℂ := MvPolynomial.eval₂ Polynomial.C (fun _ : Fin 1 => Polynomial.X) Q
    have hq_eval : ∀ (T : MvPolynomial (Fin 1) ℂ) (c : ℂ),
        (MvPolynomial.eval₂ Polynomial.C (fun _ : Fin 1 => Polynomial.X) T).eval c =
          MvPolynomial.eval (fun _ : Fin 1 => c) T := by
      intro T c
      induction T using MvPolynomial.induction_on with
      | C a => simp
      | add a b ha hb => simp [MvPolynomial.eval₂_add, ha, hb]
      | mul_X a i ha => simp [MvPolynomial.eval₂_mul, ha]
    have hq0 : q = 0 := by
      by_contra hq_ne
      obtain ⟨a, ha⟩ := hU_ne
      obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp hU_open a ha
      have hIoo_sub : Set.Ioo (a - ε) (a + ε) ⊆ U := by
        rw [← Real.ball_eq_Ioo]
        exact hball
      have hU_inf : U.Infinite := (Set.Ioo_infinite (by linarith)).mono hIoo_sub
      have hCU_inf : (Complex.ofReal '' U).Infinite :=
        hU_inf.image (Complex.ofReal_injective.injOn)
      obtain ⟨w, hwU, hwnot⟩ := hCU_inf.exists_notMem_finset q.roots.toFinset
      obtain ⟨z, hzU, rfl⟩ := hwU
      have hvan := hQ_vanish z hzU
      have hy_fin : (fun i : Fin 1 => y i.val z) = fun _ : Fin 1 => (z : ℂ) := by
        funext i; fin_cases i; simp [y]
      rw [hy_fin, ← hq_eval Q (z : ℂ)] at hvan
      exact hwnot (Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hq_ne).mpr hvan))
    have hQ0 : Q = 0 := by
      apply MvPolynomial.funext
      intro w
      have hw : w = fun _ : Fin 1 => w 0 := funext fun i => by fin_cases i; rfl
      rw [hw, ← hq_eval Q (w 0), show eval₂ Polynomial.C (fun _ : Fin 1 => Polynomial.X) Q = q from rfl,
        hq0, Polynomial.eval_zero, map_zero]
    have hp0 : MvPolynomial.pderiv (Fin.last 0) Q = 0 := by rw [hQ0, map_zero]
    rw [hp0, map_zero] at hS_ne
    exact hS_ne rfl
  have hjet_eq : ∀ z : ℝ, (fun i : Fin (n + 1) => y i.val z) = fun i => jetVec f n i z := by
    intro z; ext i; simp [y, jetVec]
  refine ⟨n, Q, x₀, Nat.pos_of_ne_zero hn_ne, hx₀, ?_, ?_⟩
  · simpa [topSep, hjet_eq x₀] using hS_ne
  · intro z hz
    simpa [hjet_eq z] using hQ_vanish z hz

private lemma ordinary_closure_generated {ι : Type} [Fintype ι] (uState : ι → ℝ → ℂ)
    (x₀ : ℝ) {U : Set ℝ} (hU_open : IsOpen U) (hx₀ : x₀ ∈ U)
    {f : ℝ → ℂ} (hf_ana : AnalyticOnNhd ℝ f U)
    {n : ℕ} (_hn : 0 < n) (Q : MvPolynomial (Fin (n + 1)) ℂ)
    (hS0 : topSep f n Q x₀ ≠ 0)
    (hQ_vanish : ∀ z ∈ U, MvPolynomial.eval (fun j => jetVec f n j z) Q = 0)
    (hv : ∀ i : Fin (n + 1), Generated uState x₀ (jetVec f n i))
    (hinvS : Generated uState x₀ (fun t => (topSep f n Q t)⁻¹)) :
    (∀ᶠ z in 𝓝 x₀,
      (∀ i : Fin (n + 1), DifferentiableAt ℝ (jetVec f n i) z) ∧
        DifferentiableAt ℝ (fun t => (topSep f n Q t)⁻¹) z) ∧
    (∀ i : Fin (n + 1), Generated uState x₀ (_root_.deriv (jetVec f n i))) ∧
    Generated uState x₀ (_root_.deriv (fun t => (topSep f n Q t)⁻¹)) := by
  classical
  let v := jetVec f n
  let top : Fin (n + 1) := Fin.last n
  let g : Fin (n + 1) → ℝ → ℂ := fun i z =>
    MvPolynomial.eval (fun j => v j z) (MvPolynomial.pderiv i Q)
  let S : ℝ → ℂ := topSep f n Q
  have hd : ∀ z ∈ U, ∀ i : Fin (n + 1), DifferentiableAt ℝ (v i) z := by
    intro z hz i
    obtain ⟨k, hk⟩ := i
    cases k with
    | zero =>
      have hv0 : v ⟨0, hk⟩ = fun t : ℝ => (t : ℂ) := by ext t; simp [v, jetVec]
      rw [hv0]
      exact Complex.ofRealCLM.differentiableAt
    | succ k =>
      have hvk : v ⟨k + 1, hk⟩ = iteratedDeriv k f := by ext t; simp [v, jetVec]
      rw [hvk]
      exact (analyticOnNhd_iteratedDeriv hf_ana k z hz).differentiableAt
  have chain : ∀ (A : MvPolynomial (Fin (n + 1)) ℂ) (z : ℝ), z ∈ U →
      HasDerivAt (fun p => MvPolynomial.eval (fun i => v i p) A)
        (∑ i, MvPolynomial.eval (fun j => v j z) (MvPolynomial.pderiv i A) * _root_.deriv (v i) z) z :=
    fun A z hz => polynomial_chain A v (fun i => _root_.deriv (v i)) z fun i => (hd z hz i).hasDerivAt
  have hS_diff : ∀ z ∈ U, DifferentiableAt ℝ S z := fun z hz =>
    (chain (MvPolynomial.pderiv top Q) z hz).differentiableAt
  have Snz : ∀ᶠ z in 𝓝 x₀, S z ≠ 0 :=
    (hS_diff x₀ hx₀).continuousAt.eventually_ne hS0
  have hsmooth : ∀ᶠ z in 𝓝 x₀,
      (∀ i : Fin (n + 1), DifferentiableAt ℝ (v i) z) ∧
        DifferentiableAt ℝ (fun t => (S t)⁻¹) z := by
    filter_upwards [hU_open.mem_nhds hx₀, Snz] with z hz nz
    exact ⟨hd z hz, (hS_diff z hz).inv nz⟩
  let G := Generated uState x₀
  have gc (c : ℂ) : G (fun _ => c) := Generated.const _
  have gg (i : Fin (n + 1)) : G (g i) := Generated.evalPoly v hv _
  have low (i : Fin (n + 1)) (hi : i ≠ top) : G (_root_.deriv (v i)) := by
    obtain ⟨k, hk⟩ := i
    cases k with
    | zero =>
      have hv0 : v ⟨0, hk⟩ = fun t : ℝ => (t : ℂ) := by ext t; simp [v, jetVec]
      have hd0 : ∀ z : ℝ, _root_.deriv (v ⟨0, hk⟩) z = 1 := by
        intro z; rw [hv0]; simpa using (hasDerivAt_id z).ofReal_comp.deriv
      exact (gc 1).congr (Eventually.of_forall fun z => (hd0 z).symm)
    | succ k =>
      have hlt : k + 2 < n + 1 := by
        have h : k + 1 ≠ n := fun eqn => hi (Fin.ext eqn); omega
      refine (hv ⟨k + 2, hlt⟩).congr (Eventually.of_forall fun z => ?_)
      have hvk : v ⟨k + 1, hk⟩ = iteratedDeriv k f := by ext t; simp [v, jetVec]
      have hv2 : v ⟨k + 2, hlt⟩ z = iteratedDeriv (k + 1) f z := by simp [v, jetVec]
      change v ⟨k + 2, hlt⟩ z = _root_.deriv (v ⟨k + 1, hk⟩) z
      rw [hv2, hvk, iteratedDeriv_succ]
  let lowSum := ∑ i ∈ Finset.univ.erase top, g i * _root_.deriv (v i)
  have gl : G lowSum :=
    Generated.finsetSum _ _ fun i hi => (gg i).mul (low i (Finset.mem_erase.mp hi).1)
  have vanish : ∀ z ∈ U, ∑ i : Fin (n + 1), g i z * _root_.deriv (v i) z = 0 := by
    intro z hz
    have near : (fun w => MvPolynomial.eval (fun i => v i w) Q) =ᶠ[𝓝 z] fun _ => 0 := by
      filter_upwards [hU_open.mem_nhds hz] with w hw
      exact hQ_vanish w hw
    exact (chain Q z hz).deriv.symm.trans (near.deriv_eq.trans (deriv_const _ _))
  have dv (i : Fin (n + 1)) : G (_root_.deriv (v i)) := by
    by_cases hi : i = top
    · subst i
      apply (((gc (-1)).mul gl).mul hinvS).congr
      filter_upwards [hU_open.mem_nhds hx₀, Snz] with z hz nz
      have he := vanish z hz
      rw [← Finset.add_sum_erase Finset.univ (fun i => g i z * _root_.deriv (v i) z) (Finset.mem_univ top)] at he
      change (-1) * lowSum z * (S z)⁻¹ = _root_.deriv (v top) z
      have hSt : S z = g top z := rfl
      have hh : S z * _root_.deriv (v top) z + lowSum z = 0 := by
        simpa [hSt, lowSum, Finset.sum_apply] using he
      field_simp [nz]
      linear_combination -hh
    · exact low i hi
  have dS : G (_root_.deriv S) := by
    let D (i : Fin (n + 1)) (z : ℝ) :=
      MvPolynomial.eval (fun k => v k z) (MvPolynomial.pderiv i (MvPolynomial.pderiv top Q))
    have gen (i) : G (D i) := Generated.evalPoly v hv _
    apply (Generated.finsetSum Finset.univ _ fun i _ => (gen i).mul (dv i)).congr
    filter_upwards [hU_open.mem_nhds hx₀] with z hz
    have hSeq : (fun p => MvPolynomial.eval (fun i => v i p) (MvPolynomial.pderiv top Q)) = S := rfl
    have hc := (chain (MvPolynomial.pderiv top Q) z hz).deriv.symm
    rw [hSeq] at hc
    simpa [D, Finset.sum_apply] using hc
  have dinvS : G (_root_.deriv (fun t => (S t)⁻¹)) := by
    apply (((gc (-1)).mul dS).mul (hinvS.pow 2)).congr
    filter_upwards [hU_open.mem_nhds hx₀, Snz] with z hz nz
    have hi := ((hS_diff z hz).hasDerivAt.inv nz).deriv
    change _root_.deriv (fun t => (S t)⁻¹) z = -_root_.deriv S z / (S z) ^ 2 at hi
    change (-1) * _root_.deriv S z * ((S z)⁻¹) ^ 2 = _root_.deriv (fun t => (S t)⁻¹) z
    rw [hi]; simp [inv_pow, div_eq_mul_inv]
  exact ⟨hsmooth, dv, dinvS⟩

private noncomputable def flipODEHom {r : ℕ} :
    MvPolynomial (Fin (r + 1)) (Polynomial ℂ) →+*
      MvPolynomial (Fin (r + 1)) (Polynomial ℂ) :=
  MvPolynomial.eval₂Hom
    (MvPolynomial.C.comp (Polynomial.eval₂RingHom Polynomial.C (1 - Polynomial.X)))
    (fun j : Fin (r + 1) => MvPolynomial.C (Polynomial.C ((-1 : ℂ) ^ j.val)) * MvPolynomial.X j)

private lemma eval_evalU_flipODE {r : ℕ}
    (P : MvPolynomial (Fin (r + 1)) (Polynomial ℂ)) (u : ℂ) (y : Fin (r + 1) → ℂ) :
    MvPolynomial.eval y (evalU (flipODEHom P) u) =
      MvPolynomial.eval (fun j : Fin (r + 1) => (-1 : ℂ) ^ j.val * y j) (evalU P (1 - u)) := by
  have hhom :
      ((MvPolynomial.eval y).comp (MvPolynomial.map (Polynomial.evalRingHom u))).comp
          (flipODEHom (r := r)) =
        ((MvPolynomial.eval (fun j : Fin (r + 1) => (-1 : ℂ) ^ j.val * y j)).comp
          (MvPolynomial.map (Polynomial.evalRingHom (1 - u)))) := by
    apply MvPolynomial.ringHom_ext
    · intro p
      simp only [RingHom.coe_comp, Function.comp_apply, flipODEHom, MvPolynomial.eval₂Hom_C,
        MvPolynomial.map_C, MvPolynomial.eval_C, Polynomial.coe_evalRingHom]
      have h : (Polynomial.evalRingHom u).comp
          (Polynomial.eval₂RingHom Polynomial.C (1 - Polynomial.X)) =
          Polynomial.evalRingHom (1 - u) := by
        apply Polynomial.ringHom_ext
        · intro c; simp
        · simp
      exact RingHom.congr_fun h p
    · intro j
      simp [flipODEHom]
  exact RingHom.congr_fun hhom P

private lemma flipODE_eq_zero_imp {r : ℕ}
    {P : MvPolynomial (Fin (r + 1)) (Polynomial ℂ)} (hP : flipODEHom P = 0) : P = 0 := by
  refine eq_zero_of_eval_evalU_eq_zero fun u x => ?_
  have h1 := eval_evalU_flipODE P (1 - u) (fun j => (-1 : ℂ) ^ j.val * x j)
  rw [hP, evalU, map_zero, map_zero] at h1
  have h1sub : 1 - (1 - u) = u := by ring
  have hmul : (fun j : Fin (r + 1) => (-1 : ℂ) ^ j.val * ((-1 : ℂ) ^ j.val * x j)) = x := by
    funext j
    rw [← mul_assoc, ← mul_pow]
    simp
  rw [h1sub, hmul] at h1
  exact h1.symm

/-! ### 3. Functional-Equation Reduction & Ostrowski's Theorem (1920) -/

private lemma cos_pi_mul_div_two_ne_zero_of_Ioo {x : ℝ} (hx : x ∈ Set.Ioo (2 : ℝ) 3) :
    Complex.cos ((Real.pi : ℂ) * (x : ℂ) / 2) ≠ 0 := by
  intro h0
  obtain ⟨k, hk⟩ := Complex.cos_eq_zero_iff.mp h0
  have hre := congrArg Complex.re hk
  have hre_lhs : ((Real.pi : ℂ) * (x : ℂ) / 2).re = Real.pi * x / 2 := by
    simp [mul_div_assoc]
  have hre_rhs : (((2 * (k : ℂ) + 1) * (Real.pi : ℂ) / 2)).re = (2 * (k : ℝ) + 1) * Real.pi / 2 := by
    simp [mul_div_assoc]
  rw [hre_lhs, hre_rhs] at hre
  have hx_eq : x = 2 * (k : ℝ) + 1 := by
    have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
    field_simp [hpi] at hre
    linarith
  have hk_gt : (1 : ℤ) < 2 * k := by
    have h1 : (2 : ℝ) < 2 * (k : ℝ) + 1 := hx_eq ▸ hx.1
    have h2 : (1 : ℝ) < ((2 * k : ℤ) : ℝ) := by push_cast; linarith
    exact_mod_cast h2
  have hk_lt : 2 * k < (2 : ℤ) := by
    have h1 : 2 * (k : ℝ) + 1 < (3 : ℝ) := hx_eq ▸ hx.2
    have h2 : ((2 * k : ℤ) : ℝ) < (2 : ℝ) := by push_cast; linarith
    exact_mod_cast h2
  omega

private lemma gamma_eq_of_Ioo {x : ℝ} (hx : x ∈ Set.Ioo (2 : ℝ) 3) :
    Complex.Gamma (x : ℂ) =
      (2⁻¹ : ℂ) * Complex.exp ((x : ℂ) * Complex.log (2 * (Real.pi : ℂ))) *
        (Complex.cos ((Real.pi : ℂ) * (x : ℂ) / 2))⁻¹ *
        (riemannZeta (x : ℂ))⁻¹ *
        riemannZeta (1 - (x : ℂ)) := by
  have hx_gt1 : (1 : ℝ) < x := by linarith [hx.1]
  have hs_neg : ∀ n : ℕ, (x : ℂ) ≠ -(n : ℂ) := by
    intro n hn
    have hr := congrArg Complex.re hn
    simp only [Complex.ofReal_re, Complex.neg_re, Complex.natCast_re] at hr
    have : (0 : ℝ) ≤ n := Nat.cast_nonneg n
    linarith [hx.1]
  have hs_ne1 : (x : ℂ) ≠ 1 := by
    intro h1
    have hr := congrArg Complex.re h1
    simp only [Complex.ofReal_re, Complex.one_re] at hr
    linarith [hx.1]
  have hfe := riemannZeta_one_sub hs_neg hs_ne1
  have h2pi_ne : (2 * (Real.pi : ℂ)) ≠ 0 :=
    mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)
  have hcpow : (2 * (Real.pi : ℂ)) ^ (-(x : ℂ)) =
      (Complex.exp ((x : ℂ) * Complex.log (2 * (Real.pi : ℂ))))⁻¹ := by
    rw [Complex.cpow_def_of_ne_zero h2pi_ne, mul_neg, mul_comm, Complex.exp_neg]
  have hexp_ne : Complex.exp ((x : ℂ) * Complex.log (2 * (Real.pi : ℂ))) ≠ 0 :=
    Complex.exp_ne_zero _
  have hcos_ne : Complex.cos ((Real.pi : ℂ) * (x : ℂ) / 2) ≠ 0 :=
    cos_pi_mul_div_two_ne_zero_of_Ioo hx
  have hcos_ne' : Complex.cos ((x : ℂ) * (Real.pi : ℂ) / 2) ≠ 0 := by
    simpa [mul_comm] using hcos_ne
  have hzeta_ne : riemannZeta (x : ℂ) ≠ 0 :=
    riemannZeta_ne_zero_of_one_le_re (by simpa only [Complex.ofReal_re] using hx_gt1.le)
  rw [hcpow] at hfe
  rw [hfe]
  field_simp [hexp_ne, hcos_ne, hcos_ne', hzeta_ne]

/-- **Ostrowski's Theorem (1920) over `ℂ[u]` on `ℂ \ {1}`**:
`riemannZeta` satisfies NO nonzero algebraic differential equation over `ℂ[u]` on `ℂ \ {1}`. -/
theorem ostrowski_riemannZeta_no_complex_ade {r : ℕ}
    (P : MvPolynomial (Fin (r + 1)) (Polynomial ℂ))
    (hP : ∀ z : ℂ, z ≠ 1 →
      MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val riemannZeta z)
        (evalU P z) = 0) :
    P = 0 := by
  classical
  by_contra hP_ne
  let U₁ : Set ℝ := Set.Ioo (2 : ℝ) 3
  have hU₁_open : IsOpen U₁ := isOpen_Ioo
  have hU₁_ne : U₁.Nonempty := ⟨5 / 2, by simp only [U₁, Set.mem_Ioo]; constructor <;> norm_num⟩
  let f₁ : ℝ → ℂ := fun t => riemannZeta (t : ℂ)
  let f₂ : ℝ → ℂ := fun t => riemannZeta (1 - (t : ℂ))
  have hf₁_ana : AnalyticOnNhd ℝ f₁ U₁ := by
    intro t ht
    have ht_ne : (t : ℂ) ≠ 1 := by
      intro h1; have hr := congrArg Complex.re h1
      simp only [Complex.ofReal_re, Complex.one_re] at hr; linarith [ht.1]
    exact ((analyticOn_riemannZeta (t : ℂ) ht_ne).restrictScalars (𝕜 := ℝ)).comp
      (Complex.ofRealCLM.analyticAt t)
  have hf₂_ana_U₁ : AnalyticOnNhd ℝ f₂ U₁ := by
    intro t ht
    have ht_ne : 1 - (t : ℂ) ≠ 1 := by
      intro h1; have hr := congrArg Complex.re h1
      simp only [Complex.sub_re, Complex.one_re, Complex.ofReal_re] at hr; linarith [ht.1]
    have hc : AnalyticAt ℂ (fun z : ℂ => riemannZeta (1 - z)) (t : ℂ) :=
      (analyticOn_riemannZeta (1 - (t : ℂ)) ht_ne).comp
        ((analyticAt_const (v := (1 : ℂ))).sub analyticAt_id)
    exact (hc.restrictScalars (𝕜 := ℝ)).comp (Complex.ofRealCLM.analyticAt t)
  have hP_f₁ : ∀ x ∈ U₁,
      MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val f₁ x) (evalU P (x : ℂ)) = 0 := by
    intro x hx
    have hx_ne : (x : ℂ) ≠ 1 := by
      intro h1; have hr := congrArg Complex.re h1
      simp only [Complex.ofReal_re, Complex.one_re] at hr; linarith [hx.1]
    have hiter : (fun j : Fin (r + 1) => iteratedDeriv j.val f₁ x) =
        fun j : Fin (r + 1) => iteratedDeriv j.val riemannZeta (x : ℂ) :=
      funext fun j => iteratedDeriv_zeta_ofReal j.val hx_ne
    rw [hiter]
    exact hP (x : ℂ) hx_ne
  obtain ⟨n₁, Q₁, x₁, hn₁, hx₁, hS₁_x₁, hQ₁_vanish⟩ :=
    exists_ordinary_ode U₁ hU₁_open hU₁_ne f₁ P hP_ne hP_f₁
  let U₂ : Set ℝ := {x ∈ U₁ | topSep f₁ n₁ Q₁ x ≠ 0}
  have hU₂_sub : U₂ ⊆ U₁ := fun _ hx => hx.1
  have hS₁_cont : ∀ x ∈ U₁, ContinuousAt (topSep f₁ n₁ Q₁) x := by
    intro x hx
    have hv_cont : ∀ j : Fin (n₁ + 1), ContinuousAt (jetVec f₁ n₁ j) x := by
      intro j
      obtain ⟨k, hk⟩ := j
      cases k with
      | zero =>
        have hv0 : jetVec f₁ n₁ ⟨0, hk⟩ = fun t : ℝ => (t : ℂ) := by ext t; simp [jetVec]
        rw [hv0]
        exact Complex.ofRealCLM.continuous.continuousAt
      | succ k =>
        have hvk : jetVec f₁ n₁ ⟨k + 1, hk⟩ = iteratedDeriv k f₁ := by ext t; simp [jetVec]
        rw [hvk]
        exact (analyticOnNhd_iteratedDeriv hf₁_ana k x hx).continuousAt
    change ContinuousAt (fun t => MvPolynomial.eval (fun j => jetVec f₁ n₁ j t)
      (MvPolynomial.pderiv (Fin.last n₁) Q₁)) x
    clear hx₁ hS₁_x₁ hQ₁_vanish
    induction (MvPolynomial.pderiv (Fin.last n₁) Q₁) using MvPolynomial.induction_on with
    | C c => simpa using continuousAt_const
    | add A B hA hB => simpa only [map_add] using! hA.add hB
    | mul_X A j hA => simpa only [map_mul, MvPolynomial.eval_X] using! hA.mul (hv_cont j)
  have hU₂_open : IsOpen U₂ := by
    rw [isOpen_iff_mem_nhds]
    intro x ⟨hxU₁, hxS⟩
    filter_upwards [hU₁_open.mem_nhds hxU₁, (hS₁_cont x hxU₁).eventually_ne hxS] with y hyU₁ hyS
    exact ⟨hyU₁, hyS⟩
  have hU₂_ne : U₂.Nonempty := ⟨x₁, hx₁, hS₁_x₁⟩
  have hflip_ne : flipODEHom P ≠ 0 := fun h0 => hP_ne (flipODE_eq_zero_imp h0)
  have hP_f₂ : ∀ x ∈ U₂,
      MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val f₂ x)
        (evalU (flipODEHom P) (x : ℂ)) = 0 := by
    intro x hx
    have hx₁' : x ∈ U₁ := hx.1
    have hx_ne : 1 - (x : ℂ) ≠ 1 := by
      intro h1; have hr := congrArg Complex.re h1
      simp only [Complex.sub_re, Complex.one_re, Complex.ofReal_re] at hr; linarith [hx₁'.1]
    rw [eval_evalU_flipODE]
    have hiter : (fun j : Fin (r + 1) => (-1 : ℂ) ^ j.val * iteratedDeriv j.val f₂ x) =
        fun j : Fin (r + 1) => iteratedDeriv j.val riemannZeta (1 - (x : ℂ)) := by
      funext j
      rw [show iteratedDeriv j.val f₂ x =
          (-1 : ℂ) ^ j.val * iteratedDeriv j.val riemannZeta (1 - (x : ℂ)) from
        iteratedDeriv_zeta_one_sub_ofReal j.val hx_ne, ← mul_assoc, ← mul_pow]
      simp
    rw [hiter]
    exact hP (1 - (x : ℂ)) hx_ne
  obtain ⟨n₂, Q₂, x₀, hn₂, hx₀_U₂, hS₂_x₀, hQ₂_vanish⟩ :=
    exists_ordinary_ode U₂ hU₂_open hU₂_ne f₂ (flipODEHom P) hflip_ne hP_f₂
  have hx₀_U₁ : x₀ ∈ U₁ := hx₀_U₂.1
  have hS₁_x₀ : topSep f₁ n₁ Q₁ x₀ ≠ 0 := hx₀_U₂.2
  have hf₂_ana_U₂ : AnalyticOnNhd ℝ f₂ U₂ := fun z hz => hf₂_ana_U₁ z (hU₂_sub hz)
  let log2pi : ℂ := Complex.log (2 * (Real.pi : ℂ))
  let invS₁ : ℝ → ℂ := fun t => (topSep f₁ n₁ Q₁ t)⁻¹
  let invS₂ : ℝ → ℂ := fun t => (topSep f₂ n₂ Q₂ t)⁻¹
  let invZeta : ℝ → ℂ := fun t => (riemannZeta (t : ℂ))⁻¹
  let exp2pi : ℝ → ℂ := fun t => Complex.exp ((t : ℂ) * log2pi)
  let cosHalf : ℝ → ℂ := fun t => Complex.cos ((Real.pi : ℂ) * (t : ℂ) / 2)
  let sinHalf : ℝ → ℂ := fun t => Complex.sin ((Real.pi : ℂ) * (t : ℂ) / 2)
  let invCosHalf : ℝ → ℂ := fun t => (cosHalf t)⁻¹
  let aux : Fin 7 → ℝ → ℂ :=
    ![invS₁, invS₂, invZeta, exp2pi, cosHalf, sinHalf, invCosHalf]
  let uState : Fin (n₁ + 1) ⊕ Fin (n₂ + 1) ⊕ Fin 7 → ℝ → ℂ :=
    Sum.elim (jetVec f₁ n₁) (Sum.elim (jetVec f₂ n₂) aux)
  let G := Generated uState x₀
  have gv₁ : ∀ i : Fin (n₁ + 1), G (jetVec f₁ n₁ i) := fun i =>
    Generated.coord (u := uState) (.inl i)
  have gv₂ : ∀ i : Fin (n₂ + 1), G (jetVec f₂ n₂ i) := fun i =>
    Generated.coord (u := uState) (.inr (.inl i))
  have gaux : ∀ k : Fin 7, G (aux k) := fun k =>
    Generated.coord (u := uState) (.inr (.inr k))
  have ginvS₁ : G invS₁ := gaux 0
  have ginvS₂ : G invS₂ := gaux 1
  have ginvZeta : G invZeta := gaux 2
  have gexp2pi : G exp2pi := gaux 3
  have gcosHalf : G cosHalf := gaux 4
  have gsinHalf : G sinHalf := gaux 5
  have ginvCosHalf : G invCosHalf := gaux 6
  have gc (c : ℂ) : G (fun _ => c) := Generated.const _
  obtain ⟨hsmooth₁, dv₁, dinvS₁⟩ :=
    ordinary_closure_generated uState x₀ hU₁_open hx₀_U₁ hf₁_ana hn₁ Q₁ hS₁_x₀ hQ₁_vanish gv₁ ginvS₁
  obtain ⟨hsmooth₂, dv₂, dinvS₂⟩ :=
    ordinary_closure_generated uState x₀ hU₂_open hx₀_U₂ hf₂_ana_U₂ hn₂ Q₂ hS₂_x₀ hQ₂_vanish gv₂ ginvS₂
  have harg_deriv : ∀ t : ℝ, HasDerivAt (fun u : ℝ => (Real.pi : ℂ) * (u : ℂ) / 2)
      ((Real.pi : ℂ) / 2) t := fun t => by
    simpa using (((hasDerivAt_id t).ofReal_comp.const_mul (Real.pi : ℂ)).div_const 2)
  have hexp_deriv : ∀ t : ℝ, HasDerivAt exp2pi (log2pi * exp2pi t) t := fun t => by
    have h1 : HasDerivAt (fun u : ℝ => (u : ℂ) * log2pi) (1 * log2pi) t :=
      ((hasDerivAt_id t).ofReal_comp).mul_const log2pi
    simpa [exp2pi, mul_comm] using h1.cexp
  have hcos_deriv : ∀ t : ℝ, HasDerivAt cosHalf (-((Real.pi : ℂ) / 2) * sinHalf t) t := fun t => by
    have h := (Complex.hasDerivAt_cos ((Real.pi : ℂ) * (t : ℂ) / 2)).scomp t (harg_deriv t)
    exact h.congr_deriv (by simp [sinHalf, smul_eq_mul])
  have hsin_deriv : ∀ t : ℝ, HasDerivAt sinHalf (((Real.pi : ℂ) / 2) * cosHalf t) t := fun t => by
    have h := (Complex.hasDerivAt_sin ((Real.pi : ℂ) * (t : ℂ) / 2)).scomp t (harg_deriv t)
    exact h.congr_deriv (by simp [cosHalf, smul_eq_mul])
  let idx1₁ : Fin (n₁ + 1) := ⟨1, Nat.succ_lt_succ hn₁⟩
  let idx1₂ : Fin (n₂ + 1) := ⟨1, Nat.succ_lt_succ hn₂⟩
  have hv1₁ : jetVec f₁ n₁ idx1₁ = f₁ := by ext t; simp [jetVec, idx1₁]
  have hv1₂ : jetVec f₂ n₂ idx1₂ = f₂ := by ext t; simp [jetVec, idx1₂]
  have smooth : ∀ᶠ z in 𝓝 x₀, ∀ i, DifferentiableAt ℝ (uState i) z := by
    filter_upwards [hU₁_open.mem_nhds hx₀_U₁, hsmooth₁, hsmooth₂] with z hzU₁ hs₁ hs₂ i
    rcases i with i | (i | k)
    · exact hs₁.1 i
    · exact hs₂.1 i
    · fin_cases k
      · exact hs₁.2
      · exact hs₂.2
      · have hzeta_ne : riemannZeta (z : ℂ) ≠ 0 :=
          riemannZeta_ne_zero_of_one_le_re
            (by simpa only [Complex.ofReal_re] using (by linarith [hzU₁.1] : (1 : ℝ) ≤ z))
        have hdiff_z : DifferentiableAt ℝ f₁ z := by
          simpa [hv1₁] using hs₁.1 idx1₁
        exact hdiff_z.inv hzeta_ne
      · exact (hexp_deriv z).differentiableAt
      · exact (hcos_deriv z).differentiableAt
      · exact (hsin_deriv z).differentiableAt
      · exact (hcos_deriv z).differentiableAt.inv (cos_pi_mul_div_two_ne_zero_of_Ioo hzU₁)
  have closed : ∀ i, G (_root_.deriv (uState i)) := by
    intro i
    rcases i with i | (i | k)
    · exact dv₁ i
    · exact dv₂ i
    · fin_cases k
      · exact dinvS₁
      · exact dinvS₂
      · change G (_root_.deriv invZeta)
        have df₁ : G (_root_.deriv f₁) := by simpa [hv1₁] using dv₁ idx1₁
        apply (((gc (-1)).mul df₁).mul (ginvZeta.pow 2)).congr
        filter_upwards [hU₁_open.mem_nhds hx₀_U₁, hsmooth₁] with z hzU₁ hs₁
        have hzeta_ne : riemannZeta (z : ℂ) ≠ 0 :=
          riemannZeta_ne_zero_of_one_le_re
            (by simpa only [Complex.ofReal_re] using (by linarith [hzU₁.1] : (1 : ℝ) ≤ z))
        have hdiff_z : DifferentiableAt ℝ f₁ z := by
          simpa [hv1₁] using hs₁.1 idx1₁
        have hi := (hdiff_z.hasDerivAt.inv hzeta_ne).deriv
        change (-1) * _root_.deriv f₁ z * (invZeta z) ^ 2 = _root_.deriv invZeta z
        change _root_.deriv invZeta z = -_root_.deriv f₁ z / (f₁ z) ^ 2 at hi
        rw [hi]; simp [invZeta, f₁, inv_pow, div_eq_mul_inv]
      · change G (_root_.deriv exp2pi)
        exact ((gc log2pi).mul gexp2pi).congr (Eventually.of_forall fun z => (hexp_deriv z).deriv.symm)
      · change G (_root_.deriv cosHalf)
        exact ((gc (-((Real.pi : ℂ) / 2))).mul gsinHalf).congr
          (Eventually.of_forall fun z => (hcos_deriv z).deriv.symm)
      · change G (_root_.deriv sinHalf)
        exact ((gc ((Real.pi : ℂ) / 2)).mul gcosHalf).congr
          (Eventually.of_forall fun z => (hsin_deriv z).deriv.symm)
      · change G (_root_.deriv invCosHalf)
        apply (((gc ((Real.pi : ℂ) / 2)).mul gsinHalf).mul (ginvCosHalf.pow 2)).congr
        filter_upwards [hU₁_open.mem_nhds hx₀_U₁] with z hzU₁
        have hi := ((hcos_deriv z).inv (cos_pi_mul_div_two_ne_zero_of_Ioo hzU₁)).deriv
        change _root_.deriv invCosHalf z =
          -(-((Real.pi : ℂ) / 2) * sinHalf z) / cosHalf z ^ 2 at hi
        change ((Real.pi : ℂ) / 2) * sinHalf z * (invCosHalf z) ^ 2 = _root_.deriv invCosHalf z
        rw [hi]
        simp [invCosHalf, inv_pow, div_eq_mul_inv]
  have gf₂ : G f₂ := by simpa [hv1₂] using gv₂ idx1₂
  have readout_gamma : G (fun t : ℝ => Complex.Gamma (t : ℂ)) := by
    refine (((((gc (2⁻¹ : ℂ)).mul gexp2pi).mul ginvCosHalf).mul ginvZeta).mul gf₂).congr ?_
    filter_upwards [hU₁_open.mem_nhds hx₀_U₁] with t ht
    exact (gamma_eq_of_Ioo ht).symm
  obtain ⟨R, hR_ne, hR_nhds⟩ :=
    autonomous_readout uState x₀ (fun t : ℝ => Complex.Gamma (t : ℂ)) readout_gamma smooth closed
  have gamma_ofReal_ana : AnalyticOnNhd ℝ (fun t : ℝ => Complex.Gamma (t : ℂ)) (Set.Ioi 0) := by
    intro z hz
    have hzc : 0 < (z : ℂ).re := by simpa only [Complex.ofReal_re] using Set.mem_Ioi.mp hz
    have hdiff : DifferentiableOn ℂ Complex.Gamma {w : ℂ | 0 < w.re} := by
      intro w hw
      refine (Complex.differentiableAt_Gamma w fun m hm => ?_).differentiableWithinAt
      have hr := congrArg Complex.re hm
      simp only [Complex.neg_re, Complex.natCast_re] at hr
      have : (0 : ℝ) ≤ m := Nat.cast_nonneg m
      linarith [Set.mem_ofPred.mp hw]
    have hopen : IsOpen {w : ℂ | 0 < w.re} := isOpen_lt continuous_const Complex.continuous_re
    have hana : AnalyticOnNhd ℂ Complex.Gamma {w : ℂ | 0 < w.re} := hdiff.analyticOnNhd hopen
    exact ((hana (z : ℂ) hzc).restrictScalars (𝕜 := ℝ)).comp (Complex.ofRealCLM.analyticAt z)
  have R_analytic : AnalyticOnNhd ℝ
      (fun u : ℝ => MvPolynomial.eval
        (fun j : Fin (Fintype.card (Fin (n₁ + 1) ⊕ Fin (n₂ + 1) ⊕ Fin 7) + 1) =>
          iteratedDeriv j.val (fun t : ℝ => Complex.Gamma (t : ℂ)) u) R)
      (Set.Ioi 0) := by
    intro u hu
    clear hR_ne hR_nhds
    induction R using MvPolynomial.induction_on with
    | C c => simpa using analyticAt_const
    | add A B hA hB => simpa only [map_add] using! hA.add hB
    | mul_X A j hA =>
      simpa only [map_mul, MvPolynomial.eval_X] using!
        hA.mul (analyticOnNhd_iteratedDeriv gamma_ofReal_ana j.val u hu)
  have hR_tail : ∀ᶠ u : ℝ in Filter.atTop,
      MvPolynomial.eval
        (fun j : Fin (Fintype.card (Fin (n₁ + 1) ⊕ Fin (n₂ + 1) ⊕ Fin 7) + 1) =>
          iteratedDeriv j.val (fun t : ℝ => Complex.Gamma (t : ℂ)) u) R = 0 := by
    refine eventually_atTop.mpr ⟨1, fun u hu => ?_⟩
    exact R_analytic.eqOn_zero_of_preconnected_of_eventuallyEq_zero
      (convex_Ioi (0 : ℝ)).isPreconnected
      (Set.mem_Ioi.mpr (by linarith [hx₀_U₁.1]))
      hR_nhds (Set.mem_Ioi.mpr (by linarith))
  let R_poly : MvPolynomial (Fin (Fintype.card (Fin (n₁ + 1) ⊕ Fin (n₂ + 1) ⊕ Fin 7) + 1))
      (Polynomial ℂ) :=
    MvPolynomial.map Polynomial.C R
  have hR_poly_eval : ∀ u : ℂ, evalU R_poly u = R := by
    intro u
    simp only [R_poly, evalU, MvPolynomial.map_map]
    conv_rhs => rw [← MvPolynomial.map_id R]
    congr 2
    ext x
    simp
  have hR_poly_zero : R_poly = 0 := by
    refine holder_gamma_no_ade R_poly ?_
    filter_upwards [hR_tail] with u hu
    rw [hR_poly_eval, hu]
  exact hR_ne (MvPolynomial.map_injective Polynomial.C Polynomial.C_injective
    (hR_poly_zero.trans (map_zero _).symm))

/-- **Ostrowski's Theorem (1920) over `ℂ[u]`**:
`riemannZeta` restricted to `ℝ` satisfies NO nonzero algebraic differential equation over `ℂ[u]`. -/
theorem ostrowski_riemannZeta_no_ade {r : ℕ} (P : MvPolynomial (Fin (r + 1)) (Polynomial ℂ))
    (hP : ∀ᶠ u : ℝ in Filter.atTop,
      MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val (fun x : ℝ => riemannZeta (x : ℂ)) u)
        (evalU P (u : ℂ)) = 0) :
    P = 0 :=
  ostrowski_riemannZeta_no_complex_ade P (zeta_ade_atTop_to_compl_one P hP)

private lemma poly_eval_eventually_ne_zero {q : Polynomial ℂ} (hq : q ≠ 0) :
    ∀ᶠ u : ℝ in Filter.atTop, q.eval (u : ℂ) ≠ 0 := by
  let B : ℝ := Finset.sum q.roots.toFinset fun z : ℂ => ‖z‖
  have hB : 0 ≤ B := Finset.sum_nonneg fun _ _ => norm_nonneg _
  filter_upwards [eventually_gt_atTop B] with u hu h0
  have hmem : (u : ℂ) ∈ q.roots := (Polynomial.mem_roots hq).mpr h0
  have hle : ‖(u : ℂ)‖ ≤ B :=
    Finset.single_le_sum (f := fun z : ℂ => ‖z‖) (fun _ _ => norm_nonneg _)
      (Multiset.mem_toFinset.mpr hmem)
  have hpos : 0 < u := lt_of_le_of_lt hB hu
  rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpos] at hle
  linarith

private noncomputable def clearDenomPoly {r : ℕ} (P : MvPolynomial (Fin (r + 1)) (RatFunc ℂ)) :
    Polynomial ℂ :=
  ∏ α ∈ P.support, (P.coeff α).denom

private noncomputable def clearDenomMvPoly {r : ℕ} (P : MvPolynomial (Fin (r + 1)) (RatFunc ℂ)) :
    MvPolynomial (Fin (r + 1)) (Polynomial ℂ) :=
  ∑ α ∈ P.support, MvPolynomial.monomial α
    ((P.coeff α).num * ∏ β ∈ P.support.erase α, (P.coeff β).denom)

private lemma clearDenomMvPoly_coeff {r : ℕ} (P : MvPolynomial (Fin (r + 1)) (RatFunc ℂ))
    (α : Fin (r + 1) →₀ ℕ) :
    (clearDenomMvPoly P).coeff α =
      (P.coeff α).num * ∏ β ∈ P.support.erase α, (P.coeff β).denom := by
  classical
  unfold clearDenomMvPoly
  rw [MvPolynomial.coeff_sum]
  simp_rw [MvPolynomial.coeff_monomial]
  by_cases hα : α ∈ P.support
  · rw [Finset.sum_eq_single α]
    · simp
    · intro β _ hβα; simp [hβα]
    · intro hnot; exact absurd hα hnot
  · have hP0 : P.coeff α = 0 := MvPolynomial.notMem_support_iff.mp hα
    rw [hP0, RatFunc.num_zero, zero_mul, Finset.sum_eq_zero]
    intro β hβ
    have hne : β ≠ α := fun h => hα (h ▸ hβ)
    simp [hne]

private lemma clearDenomMvPoly_eq_zero_iff {r : ℕ}
    (P : MvPolynomial (Fin (r + 1)) (RatFunc ℂ)) :
    clearDenomMvPoly P = 0 ↔ P = 0 := by
  constructor
  · intro h0
    ext α
    have hc := congrArg (fun Q : MvPolynomial (Fin (r + 1)) (Polynomial ℂ) => Q.coeff α) h0
    change (clearDenomMvPoly P).coeff α = 0 at hc
    rw [clearDenomMvPoly_coeff] at hc
    have hden_ne : (∏ β ∈ P.support.erase α, (P.coeff β).denom) ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr fun _ _ => RatFunc.denom_ne_zero _
    have hnum0 : (P.coeff α).num = 0 := (mul_eq_zero.mp hc).resolve_right hden_ne
    exact RatFunc.num_eq_zero_iff.mp hnum0
  · rintro rfl
    simp [clearDenomMvPoly]

private lemma evalU_clearDenomMvPoly {r : ℕ}
    (P : MvPolynomial (Fin (r + 1)) (RatFunc ℂ)) {u : ℂ}
    (hu : ∀ β ∈ P.support, (P.coeff β).denom.eval u ≠ 0) :
    evalU (clearDenomMvPoly P) u = (clearDenomPoly P).eval u • evalRatU P u := by
  classical
  ext α
  rw [evalU, MvPolynomial.coeff_map, Polynomial.coe_evalRingHom, clearDenomMvPoly_coeff,
    MvPolynomial.coeff_smul, smul_eq_mul, evalRatU, MvPolynomial.coeff_sum]
  simp_rw [MvPolynomial.coeff_monomial]
  by_cases hα : α ∈ P.support
  · rw [Finset.sum_eq_single α]
    · simp only [↓reduceIte, ratEval, clearDenomPoly, Polynomial.eval_prod]
      rw [← Finset.mul_prod_erase P.support (fun β => (P.coeff β).denom.eval u) hα,
        Polynomial.eval_mul, Polynomial.eval_prod]
      field_simp [hu α hα]
    · intro β _ hβα; simp [hβα]
    · intro hnot; exact absurd hα hnot
  · have hP0 : P.coeff α = 0 := MvPolynomial.notMem_support_iff.mp hα
    rw [hP0, RatFunc.num_zero, zero_mul, Polynomial.eval_zero, Finset.sum_eq_zero]
    · simp
    · intro β hβ
      rw [ite_eq_right_iff]
      intro hβα
      subst hβα
      exact absurd hβ hα

/-- **Ostrowski's Theorem (1920) over `ℂ(u)`**:
`riemannZeta` restricted to `ℝ` satisfies NO nonzero algebraic differential equation over `ℂ(u)`. -/
theorem ostrowski_riemannZeta_no_rat_ade {r : ℕ} (P : MvPolynomial (Fin (r + 1)) (RatFunc ℂ))
    (hP : ∀ᶠ u : ℝ in Filter.atTop,
      MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val (fun x : ℝ => riemannZeta (x : ℂ)) u)
        (evalRatU P (u : ℂ)) = 0) :
    P = 0 := by
  have hden : ∀ᶠ u : ℝ in Filter.atTop, ∀ β ∈ P.support, (P.coeff β).denom.eval (u : ℂ) ≠ 0 :=
    (Filter.eventually_all_finset P.support).mpr fun β _ =>
      poly_eval_eventually_ne_zero (RatFunc.denom_ne_zero _)
  have hP_clear : ∀ᶠ u : ℝ in Filter.atTop,
      MvPolynomial.eval (fun j : Fin (r + 1) => iteratedDeriv j.val (fun x : ℝ => riemannZeta (x : ℂ)) u)
        (evalU (clearDenomMvPoly P) (u : ℂ)) = 0 := by
    filter_upwards [hP, hden] with u hu hdu
    rw [evalU_clearDenomMvPoly P hdu, MvPolynomial.smul_eq_C_mul, map_mul, MvPolynomial.eval_C, hu,
      mul_zero]
  exact (clearDenomMvPoly_eq_zero_iff P).mp (ostrowski_riemannZeta_no_ade (clearDenomMvPoly P) hP_clear)

end
